script RevelationMap_Lobby_EnvironmentChanged {
	playse(SE_SAVE)
	waitse
	msgbox("The battle environment has been changed\n"
			"to {STR_VAR_1} environment.\l"
			"Enjoy the terrain!", MSGBOX_AUTOCLOSE)
	release
	end
}

text Text_PleaseComeAgain {
	"Please come again if you change your\n"
	"mind."
}

script RevelationMap_Lobby_EventScript_EventMoveRelearner {
	lock
	faceplayer
	special(ShowBattlePointsWindow)
	if (specialvar(VAR_TEMP_1, GetFrontierBattlePoints) >= 15) {
		msgbox("Hi, I'm the event moves relearner.\n"
				"For just 15 Battle Points, I can\l"
				"teach your Pokémon some exclusive\l"
				"moves!\p"
				"Would you like to learn some\n"
				"exclusive moves?", MSGBOX_YESNO)
	} else {
		msgbox("Hi, I'm the event moves relearner.\p"
				"…\n"
				"It looks like you don't have enough\l"
				"Battle Points to learn exclusive\l"
				"moves.\p"
				"Come back again when you have at\n"
				"least 15 Battle Points.", MSGBOX_DEFAULT)
				special(CloseBattlePointsWindow)
		release
		end
	}
	closemessage
	if (var(VAR_RESULT) == YES) {
		setflag(FLAG_EVENT_MOVE_RELEARNER)
		goto(EventScript_ChooseMonForTeaching)
	} else {
		msgbox(Text_PleaseComeAgain, MSGBOX_DEFAULT)
		special(CloseBattlePointsWindow)
		release
		end
	}
}

script EventScript_ChooseMonForTeaching {
	msgbox("Which Pokémon needs teaching?", MSGBOX_DEFAULT)
	special(ChooseMonForMoveRelearner)
	waitstate
	if (var(VAR_0x8004) == PARTY_NOTHING_CHOSEN) {
		clearflag(FLAG_EVENT_MOVE_RELEARNER)
		msgbox(Text_PleaseComeAgain, MSGBOX_DEFAULT)
		release
		end
	}
	special(ShowBattlePointsWindow)
	special(IsSelectedMonEgg)
	if (var(VAR_RESULT) == TRUE) {
		msgbox("Hunh? There isn't a single move that\n"
				"I can teach an Egg.", MSGBOX_DEFAULT)
		clearflag(FLAG_EVENT_MOVE_RELEARNER)
		goto(EventScript_ChooseMonForTeaching)
	}
	if (var(VAR_0x8005) == NO) {
		msgbox("Sorry…\p"
				"It doesn't appear as if I have any move\n"
				"I can teach that Pokémon.", MSGBOX_DEFAULT)
		clearflag(FLAG_EVENT_MOVE_RELEARNER)
		goto(EventScript_ChooseMonForTeaching)
	} else {
		special(ShowBattlePointsWindow)
		goto(EventScript_ChooseMoveToTeach)
	}
}

script EventScript_ChooseMoveToTeach {
	msgbox("Which move should I teach?", MSGBOX_DEFAULT)
	special(TeachMoveRelearnerMove)
	waitstate
	if (var(VAR_0x8004) == 0) {
		special(ShowBattlePointsWindow)
		goto(EventScript_ChooseMonForTeaching)
	}
	setvar(VAR_0x8004, 15)
	special(TakeFrontierBattlePoints)
	special(ShowBattlePointsWindow)
	clearflag(FLAG_EVENT_MOVE_RELEARNER)
	msgbox("Thank you!\n"
			"Please come again!", MSGBOX_DEFAULT)
	special(CloseBattlePointsWindow)
	release
	end
}

script RevelationMap_Lobby_EventScript_Whiteout {
	forcesave
	if (flag(FLAG_IS_CHAMPION) == TRUE) {
		return
	}
	msgbox("{SPEAKER NAME_BENNY}"
			"Ah, {PLAYER}!\n"
			"I was cheering for you…\l"
			"I'm sorry, it didn't go as you'd expect\l"
			"it to.\p"
			"Now, would you like to reset your\n"
			"challenge with a different team?", MSGBOX_YESNO)
	if (var(VAR_RESULT) == YES) {
		msgbox("{SPEAKER NAME_BENNY}"
				"Alright, make sure to start a\n"
				"new adventure.", MSGBOX_AUTOCLOSE)
		callnative(0) // Soft resets the game. Thank you Hedara!
	} else {
		msgbox("{SPEAKER NAME_BENNY}"
			"Okay! Good luck, {PLAYER}!", MSGBOX_NPC)
	}
}

script RevelationMap_Lobby_Tips {
	setvar(VAR_TEMP_B, 0)
	goto(RevelationMap_Lobby_TipsMultichoice)
	release
	end
}

script RevelationMap_Lobby_TipsMultichoice {
	lock
	message("Select a topic:")
	copyvar(VAR_TEMP_A, VAR_TEMP_B)
	waitmessage
	dynmultichoice(0, 0, FALSE, 6, VAR_TEMP_A, DYN_MULTICHOICE_CB_NONE, "Pokémon Selection", "Poké Menu", "Revelation Challenge", "Revelation Mons", "Battle Tower", "Event Moves", "Exit")
	closemessage
	copyvar(VAR_TEMP_B, VAR_RESULT)
	switch (var(VAR_RESULT)) {
		case 0:
			msgbox("Prof. Benny allows you to select any 6\n"
					"Pokémon from the provided list.\p"
					"To get more Pokémon, complete the\n"
					"game first!", MSGBOX_AUTOCLOSE)
			goto(RevelationMap_Lobby_TipsMultichoice)
		case 1:
			msgbox("Press {L_BUTTON} to open the Poké Menu.\p"
					"It has tools to help modify various\n"
					"aspects of your Pokémon, such as stats,\l"
					"abilities, moves, and more.", MSGBOX_AUTOCLOSE)
			goto(RevelationMap_Lobby_TipsMultichoice)
		case 2:
			msgbox("The Revelation Challenge consists of\n"
					"8 Gym Leaders, 6 Challengers, and\l"
					"1 Champion.\p"
					"Each Gym has 3 Trainers:\n"
        			"a Gym Trainer, the first challenge,\l"
        			"the Gym Leader, the ultimate challenge,\l"
        			"and a Post-Gym Trainer, the final one.\p"
					"Each of them specializes in one type,\n"
					"representing all 18 types.\p"
					"The Challengers focus on specific\n"
					"strategies, such as rain or sun.\p"
					"Your party is healed after every battle.", MSGBOX_AUTOCLOSE)
			goto(RevelationMap_Lobby_TipsMultichoice)
		case 3:
			msgbox("Revelation Mons are newly discovered\n"
					"species that are quite powerful.\p"
					"They were caught by the Gym Leaders,\n"
					"who use them as their ace Pokémon.\p"
					"Lately, many more of their kind have\n"
					"been discovered.", MSGBOX_AUTOCLOSE)
			goto(RevelationMap_Lobby_TipsMultichoice)
		case 4:
			msgbox("The Battle Tower is an endless battle\n"
					"gauntlet that rewards you with\l"
					"increasing Battle Points (BP), which\l"
					"can be used at the next counter.", MSGBOX_AUTOCLOSE)
			goto(RevelationMap_Lobby_TipsMultichoice)
		case 5:
			msgbox("Event Moves are rare, limited moves\n"
					"that cannot normally be taught to\l"
					"Pokémon.\p"
					"Each move costs 15 BP, requiring you to\n"
					"play in the Battle Tower.", MSGBOX_AUTOCLOSE)
			goto(RevelationMap_Lobby_TipsMultichoice)

		default:
		case 6:
			release
			end
	}
}
