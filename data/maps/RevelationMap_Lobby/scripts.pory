mapscripts RevelationMap_Lobby_MapScripts {}

script RevelationMap_Lobby_Trigger0 {
	lock
	applymove(LOCALID_REVELATION_BIRCH, moves(face_right))
	msgbox("Benny: Excuse me, {PLAYER}!", MSGBOX_DEFAULT)
	emoteplayer(EMOTE_EXCLAM)
	turnplayer(DIR_SOUTH)
	msgbox("Benny: You have not chosen any Pokémon,\n"
			"yet!\l"
			"How do you plan on challenging the\l"
			"Trainers inside, with your bare fists?\l"
			"Please step back and choose your\l"
			"Pokémon.", MSGBOX_AUTOCLOSE)
	applymoveplayer(moves(walk_down, face_left))
	goto(Common_EventScript_ChoosePkmnMenu)
	release
	end
}

script RevelationMap_Lobby_Trigger1 {
	lock
	applymove(LOCALID_REVELATION_BIRCH, moves(face_right))
	msgbox("Benny: {PLAYER},\n"
			"once you go through that door,\l"
			"you cannot return, for any reasons.\l"
			"Incase you did something wrong,\l"
			"you will have to start over.\p"
			"Benny: So, {PLAYER}, are you absolutely\n"
			"sure that you're ready?", MSGBOX_YESNO)
	if (var(VAR_RESULT) == TRUE) {
		msgbox("Benny: Good luck, {PLAYER}!", MSGBOX_AUTOCLOSE)
		setvar(VAR_REV_STATE, 2)
	} else {
		msgbox("Benny: Alright, take your time.", MSGBOX_AUTOCLOSE)
		applymoveplayer(moves(walk_down))
	}
}

script RevelationMap_Lobby_Zigzagoon {
	lock
	if (var(VAR_FACING) == DIR_NORTH) {
		applymovement(LOCALID_REVELATION_ZIGGY, moves(jump_in_place_up_down))
	} else {
		applymovement(LOCALID_REVELATION_ZIGGY, moves(jump_in_place_right_left))
	}
	moncryscript(SPECIES_ZIGZAGOON, "Goon! Goon!", "Ziggy")
	release
	end
}

script RevelationMap_Lobby_BattleTower_Teala {
	lock
	release
}

script RevelationMap_Lobby_Purrloin {
	lock
	if (var(VAR_FACING) == DIR_NORTH) {
		applymovement(LOCALID_REVELATION_OGGY, moves(jump_in_place_up_down))
	} else {
		applymovement(LOCALID_REVELATION_OGGY, moves(jump_in_place_left_right))
	}
	moncryscript(SPECIES_PURRLOIN, "Purr!", "Oggy")
	release
	end
}
