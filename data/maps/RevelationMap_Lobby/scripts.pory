mapscripts RevelationMap_Lobby_MapScripts {
	MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
		VAR_0x800B, 1 {
			setvar(VAR_0x800B, 2)
			turnplayer(DIR_NORTH)
		}
	]
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_REV_STATE, 6 {
			setvar(VAR_REV_STATE, 1)
			msgbox("{SPEAKER NAME_BENNY}"
					"Hey, {PLAYER}!", MSGBOX_AUTOCLOSE)
			emote(OBJ_EVENT_ID_PLAYER, EMOTE_EXCLAM)
			turnplayer(DIR_NORTH)
			applymove(LOCALID_REVELATION_LOBBY_BENNY, moves(walk_left, face_down))
			setmetatile(5, 4, METATILE_PokemonCenter_Floor_Plain_Alt, FALSE) # Open counter barrier
			special(DrawWholeMapView)
			playse(SE_CLICK)
			applymovement(LOCALID_REVELATION_LOBBY_BENNY, moves(walk_down * 2, walk_right * 3, walk_down * 2))
			delay(25)
			setmetatile(5, 4, METATILE_PokemonCenter_CounterBarrier, TRUE) # Close counter barrier
			special(DrawWholeMapView)
			playse(SE_CLICK)
			waitmovement(0)
			msgbox("{SPEAKER NAME_BENNY}"
					"Congrats on becoming the new Champion!\n"
					"I knew you had it in you!\l"
					"But, do you have what it takes to beat\l"
					"me?", MSGBOX_DEFAULT)
			setflag(B_FLAG_NO_WHITEOUT)
			trainerbattle_no_intro(TRAINER_BENNY, "Well, you sure can!")
			clearflag(B_FLAG_NO_WHITEOUT)
			if (specialvar(VAR_RESULT, GetBattleOutcome) == B_OUTCOME_WON) {
				setflag(FLAG_DEFEATED_BENNY)
				msgbox("{SPEAKER NAME_BENNY}"
						"That reminded me of the good old days,\n"
						"when I was the Champion.\l"
						"Thank you, {PLAYER}!\l"
						"This was really inspiring!", MSGBOX_AUTOCLOSE)
			} else {
				msgbox("{SPEAKER NAME_BENNY}"
						"Ha!\n"
						"Looks like I still got it in me.\l"
						"Thank you for showing me that Pokémon\l"
						"battling is for all ages!\l"
						"This really refreshed me.", MSGBOX_AUTOCLOSE)
			}
			applymove(LOCALID_REVELATION_LOBBY_BENNY, moves(walk_up * 2, walk_left * 3))
			setmetatile(5, 4, METATILE_PokemonCenter_Floor_Plain_Alt, FALSE) # Open counter barrier
			special(DrawWholeMapView)
			playse(SE_CLICK)
			applymovement(LOCALID_REVELATION_LOBBY_BENNY, moves(walk_up * 2, walk_right, face_down))
			delay(25)
			setmetatile(5, 4, METATILE_PokemonCenter_CounterBarrier, TRUE) # Close counter barrier
			special(DrawWholeMapView)
			playse(SE_CLICK)
			waitmovement(0)
			end
		}
		VAR_0x800B, 2 {
			setvar(VAR_0x800B, 0)
			lock
			special(LoadPlayerParty)
			special(HealPlayerParty)
			clearflag(FLAG_FRONTIER_LEVEL_50)
			msgbox("Thank you for participating in the\n"
					"Battle Tower Challenge!\p"
					"We hope to see you again.", MSGBOX_DEFAULT)
			forcesave
			closemessage
			turnplayer(DIR_SOUTH)
			end
		}
	]
	MAP_SCRIPT_ON_TRANSITION {
		setrespawn(HEAL_LOCATION_REVELATION_LOBBY)
	}
}

script RevelationMap_Lobby_Trigger0 {
	lock
	applymove(LOCALID_REVELATION_LOBBY_BENNY, moves(face_right))
	msgbox("{SPEAKER NAME_BENNY}"
			"Excuse me, {PLAYER}!", MSGBOX_DEFAULT)
	emoteplayer(EMOTE_EXCLAM)
	turnplayer(DIR_SOUTH)
	msgbox("You have not chosen any Pokémon,\n"
			"yet!\l"
			"How do you plan on challenging the\l"
			"Trainers inside, with your bare fists?\l"
			"Please step back and choose your\l"
			"Pokémon.", MSGBOX_AUTOCLOSE)
	applymoveplayer(moves(walk_down, face_left))
	goto(RevelationMap_Lobby_SetUpPkmnMenu)
	release
	end
}

script RevelationMap_Lobby_EventScript_ProfBenny {
	lock
	faceplayer
	if (flag(FLAG_DEFEATED_BENNY) == true) {
		message("{SPEAKER NAME_BENNY}"
				"Hey, {PLAYER}!\n"
				"Are you here for battle or a Pokémon?")
		waitmessage
		dynmultichoice(0, 0, FALSE, 3, 0, DYN_MULTICHOICE_CB_NONE, "Pokémon", "Battle", "See ya!")
		closemessage
		switch (var(VAR_RESULT)) {
			case 0:
				goto(RevelationMap_Lobby_SetUpPkmnMenu)
			case 1:
				msgbox("{SPEAKER NAME_BENNY}"
						"Alright, {PLAYER}!\n"
						"No holding back!", MSGBOX_AUTOCLOSE)
				setflag(B_FLAG_NO_WHITEOUT)
				trainerbattle_no_intro(TRAINER_BENNY, "This has been fun!")
			default:
			case 2:
				msgbox("{SPEAKER NAME_BENNY}"
						"Have a good day!", MSGBOX_AUTOCLOSE)
		}
	} else {
		goto(RevelationMap_Lobby_SetUpPkmnMenu)
	}
}

script RevelationMap_Lobby_SetUpPkmnMenu {
	setvar(VAR_TEMP_B, 0)
	setvar(VAR_TEMP_D, 0)
	goto(EventScript_ChoosePkmnMenu)
}

script RevelationMap_Lobby_Trigger1 {
	lock
	applymove(LOCALID_REVELATION_LOBBY_BENNY, moves(face_right))
	msgbox("{SPEAKER NAME_BENNY}"
			"{PLAYER},\n"
			"once you go through that door,\l"
			"you cannot return, for any reasons.\l"
			"Incase you did something wrong,\l"
			"you will have to start over.\p"
			"So, {PLAYER}, are you absolutely sure\n"
			"that you're ready?", MSGBOX_YESNO)
	if (var(VAR_RESULT) == TRUE) {
		msgbox("{SPEAKER NAME_BENNY}"
				"Good luck, {PLAYER}!", MSGBOX_AUTOCLOSE)
		setvar(VAR_REV_STATE, 2)
	} else {
		msgbox("{SPEAKER NAME_BENNY}"
				"Alright, take your time.", MSGBOX_AUTOCLOSE)
		applymoveplayer(moves(walk_down))
	}
}

script RevelationMap_Lobby_BattleTower_Teala {
	lock
	faceplayer
	if (var(VAR_GOT_PARTY_PKMN) < 3) {
		msgbox("Welcome to the Battle Tower Challenge!\p"
				"Unfortunately, without at least 3\n"
				"Pokémon, I cannot let you participate\l"
				"in the challenge.\p"
				"Please come back when you have at least\n"
				"3 Pokémon!", MSGBOX_AUTOCLOSE)
	} else {
		msgbox("Welcome to the Battle Tower Challenge!\n"
				"Would you like to participate?", MSGBOX_YESNO)
		if (var(VAR_RESULT) == YES) {
			message("Which level do you wish to challenge?\n"
					"Level 50 or Level 100?")
			waitmessage
			multichoice(17, 6, MULTI_LEVEL_MODE, FALSE)
			switch (var(VAR_RESULT)) {
				case FRONTIER_LVL_50:
					setflag(FLAG_FRONTIER_LEVEL_50)
				case FRONTIER_LVL_TENT:
				case MULTI_B_PRESSED:
					special(CloseLink)
					msgbox("We look forward to seeing you on\n"
						"another challenge!")
					release
					end
			}
			frontier_checkineligible
			if (var(VAR_0x8004) == TRUE) {
				msgbox("Hmm. It looks like your party is not\n"
						"eligible for the Battle Tower.\p"
						"Please bring three eligible Pokémon.", MSGBOX_AUTOCLOSE)
				release
				end
			}
			frontier_set(FRONTIER_DATA_LVL_MODE, VAR_RESULT)
			message("Now please select the three eligible\n"
					"Pokémon that are to be entered.")
			special(SavePlayerParty)
			fadescreen(FADE_TO_BLACK)
			callnative(RemoveFollowingPokemon)
			frontier_get(FRONTIER_DATA_LVL_MODE)
			copyvar(VAR_0x8004, VAR_RESULT)
			setvar(VAR_0x8005, FRONTIER_PARTY_SIZE)
			special(ChoosePartyForBattleFrontier)
			waitstate
			if (var(VAR_RESULT) == FALSE) {
				special(LoadPlayerParty)
				callnative(UpdateFollowingPokemon)
				special(CloseLink)
				clearflag(FLAG_FRONTIER_LEVEL_50)
				msgbox("We look forward to seeing you on\n"
					"another challenge!")
				release
				end
			}
			frontier_set(FRONTIER_DATA_SELECTED_MON_ORDER)
			setvar(VAR_TEMP_CHALLENGE_STATUS, 0)
			tower_init
			tower_set(TOWER_DATA_WIN_STREAK_ACTIVE, TRUE)
			frontier_set(FRONTIER_DATA_PAUSED, FALSE)
			special(LoadPlayerParty)
			closemessage
			delay(2)
			forcesave
			setvar(VAR_TEMP_CHALLENGE_STATUS, 255)
			incrementgamestat(GAME_STAT_ENTERED_BATTLE_TOWER)
			setvar(VAR_BRAVO_TRAINER_BATTLE_TOWER_ON, TRUE)
			special(SavePlayerParty)
			setvar(VAR_0x8004, FRONTIER_UTIL_FUNC_SET_PARTY_ORDER)
			setvar(VAR_0x8005, FRONTIER_PARTY_SIZE)
			special(CallFrontierUtilFunc)
			setvar(VAR_RESULT, 0)
			setvar(VAR_TEMP_1, 0)
			msgbox("Alright, here we go!", MSGBOX_AUTOCLOSE)
			warp(MAP_BATTLE_FRONTIER_BATTLE_TOWER_BATTLE_ROOM, 4, 8)
		}
	}
	release
}

script RevelationMap_Lobby_Purrloin {
	lock
	if (var(VAR_FACING) == DIR_NORTH) {
		applymovement(LOCALID_REVELATION_LOBBY_OGGY, moves(jump_in_place_up_down))
	} else {
		applymovement(LOCALID_REVELATION_LOBBY_OGGY, moves(jump_in_place_left_right))
	}
	moncryscript(SPECIES_PURRLOIN, "Purr!", "Oggy")
	release
	end
}

