mapscripts RevelationMap_Lobby_MapScripts {
	MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
		VAR_0x8000, 1 {
			setvar(VAR_0x8000, 2)
			turnplayer(DIR_NORTH)
		}
	]
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_0x8000, 2 {
			setvar(VAR_0x8000, 0)
			lock
			special(LoadPlayerParty)
			special(HealPlayerParty)
			msgbox("Thank you for participating in the\n"
					"Battle Tower Challenge!\p"
					"We hope to see you again.", MSGBOX_NPC)
			end
		}
	]
}

script RevelationMap_Lobby_Trigger0 {
	lock
	applymove(LOCALID_REVELATION_BIRCH, moves(face_right))
	msgbox("Benny: Excuse me, {PLAYER}!", MSGBOX_DEFAULT)
	emoteplayer(EMOTE_EXCLAM)
	turnplayer(DIR_SOUTH)
	msgbox("Benny: You have not chosen any Pokémon,\n"
			"yet!\l"
			"How do you plan on challenging the\l"
			"Trainers inside, with your bare fists?\l"
			"Please step back and choose your\l"
			"Pokémon.", MSGBOX_AUTOCLOSE)
	applymoveplayer(moves(walk_down, face_left))
	goto(Common_EventScript_ChoosePkmnMenu)
	release
	end
}

script RevelationMap_Lobby_Trigger1 {
	lock
	applymove(LOCALID_REVELATION_BIRCH, moves(face_right))
	msgbox("Benny: {PLAYER},\n"
			"once you go through that door,\l"
			"you cannot return, for any reasons.\l"
			"Incase you did something wrong,\l"
			"you will have to start over.\p"
			"Benny: So, {PLAYER}, are you absolutely\n"
			"sure that you're ready?", MSGBOX_YESNO)
	if (var(VAR_RESULT) == TRUE) {
		msgbox("Benny: Good luck, {PLAYER}!", MSGBOX_AUTOCLOSE)
		setvar(VAR_REV_STATE, 2)
	} else {
		msgbox("Benny: Alright, take your time.", MSGBOX_AUTOCLOSE)
		applymoveplayer(moves(walk_down))
	}
}

script RevelationMap_Lobby_Zigzagoon {
	lock
	if (var(VAR_FACING) == DIR_NORTH) {
		applymovement(LOCALID_REVELATION_ZIGGY, moves(jump_in_place_up_down))
	} else {
		applymovement(LOCALID_REVELATION_ZIGGY, moves(jump_in_place_right_left))
	}
	moncryscript(SPECIES_ZIGZAGOON, "Goon! Goon!", "Ziggy")
	release
	end
}

script RevelationMap_Lobby_BattleTower_Teala {
	lock
	msgbox("Would you like to participate in the\n"
			"Battle Tower Challenge?", MSGBOX_YESNO)
	if (var(VAR_RESULT) == YES) {
		message("Which level do you wish to challenge?\n"
				"Level 50 or Open Level?")
		waitmessage
		multichoice(17, 6, MULTI_LEVEL_MODE, FALSE)
		switch (var(VAR_RESULT)) {
			case FRONTIER_LVL_TENT:
			case MULTI_B_PRESSED:
				special(CloseLink)
				msgbox("We look forward to seeing you on\n"
					"another challenge!")
				release
				end
		}
		frontier_checkineligible
		if (var(VAR_0x8004) == TRUE) {
			msgbox("Hmm. It looks like your party is not\n"
					"eligible for the Battle Tower.\p"
					"Please bring three eligible Pokémon.", MSGBOX_AUTOCLOSE)
		}
		frontier_set(FRONTIER_DATA_LVL_MODE, VAR_RESULT)
		message("Now please select the three eligible\n"
				"Pokémon that are to be entered.")
		special(SavePlayerParty)
		fadescreen(FADE_TO_BLACK)
		callnative(RemoveFollowingPokemon)
		frontier_get(FRONTIER_DATA_LVL_MODE)
		copyvar(VAR_0x8004, VAR_RESULT)
		setvar(VAR_0x8005, FRONTIER_PARTY_SIZE)
		special(ChoosePartyForBattleFrontier)
		waitstate
		if (var(VAR_RESULT) == FALSE) {
			special(LoadPlayerParty)
			callnative(UpdateFollowingPokemon)
			special(CloseLink)
			msgbox("We look forward to seeing you on\n"
				"another challenge!")
			release
			end
		}
		frontier_set(FRONTIER_DATA_SELECTED_MON_ORDER)
		setvar(VAR_TEMP_CHALLENGE_STATUS, 0)
		tower_init
		tower_set(TOWER_DATA_WIN_STREAK_ACTIVE, TRUE)
		frontier_set(FRONTIER_DATA_PAUSED, FALSE)
		special(LoadPlayerParty)
		closemessage
		delay(2)
		call(Common_EventScript_SaveGame)
		setvar(VAR_TEMP_CHALLENGE_STATUS, 255)
		incrementgamestat(GAME_STAT_ENTERED_BATTLE_TOWER)
		setvar(VAR_BRAVO_TRAINER_BATTLE_TOWER_ON, TRUE)
		special(SavePlayerParty)
		setvar(VAR_0x8004, FRONTIER_UTIL_FUNC_SET_PARTY_ORDER)
		setvar(VAR_0x8005, FRONTIER_PARTY_SIZE)
		special(CallFrontierUtilFunc)
		setvar(VAR_RESULT, 0)
		setvar(VAR_TEMP_1, 0)
		msgbox("Alright, here we go!", MSGBOX_AUTOCLOSE)
		warp(MAP_BATTLE_FRONTIER_BATTLE_TOWER_BATTLE_ROOM, 4, 8)
	}
	release
}

script RevelationMap_Lobby_Purrloin {
	lock
	if (var(VAR_FACING) == DIR_NORTH) {
		applymovement(LOCALID_REVELATION_OGGY, moves(jump_in_place_up_down))
	} else {
		applymovement(LOCALID_REVELATION_OGGY, moves(jump_in_place_left_right))
	}
	moncryscript(SPECIES_PURRLOIN, "Purr!", "Oggy")
	release
	end
}
