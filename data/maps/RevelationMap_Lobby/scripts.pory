mapscripts RevelationMap_Lobby_MapScripts {
	MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
		VAR_0x800B, 1 {
			setvar(VAR_0x800B, 2)
			turnplayer(DIR_NORTH)
		}
	]
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_REV_STATE, 6 {
			setvar(VAR_REV_STATE, 1)
			msgbox("Benny: Hey, {PLAYER}!", MSGBOX_AUTOCLOSE)
			emote(OBJ_EVENT_ID_PLAYER, EMOTE_EXCLAM)
			turnplayer(DIR_NORTH)
			applymove(LOCALID_REVELATION_LOBBY_BIRCH, moves(walk_left, face_down))
			setmetatile(5, 4, METATILE_PokemonCenter_Floor_Plain_Alt, FALSE) # Open counter barrier
			special(DrawWholeMapView)
			playse(SE_CLICK)
			applymovement(LOCALID_REVELATION_LOBBY_BIRCH, moves(walk_down * 2, walk_right * 3, walk_down * 2))
			delay(25)
			setmetatile(5, 4, METATILE_PokemonCenter_CounterBarrier, TRUE) # Close counter barrier
			special(DrawWholeMapView)
			playse(SE_CLICK)
			waitmovement(0)
			msgbox("Benny: Congrats on becoming the new\n"
					"Champion!\l"
					"I knew you had it in you!\l"
					"But, do you have what it takes\l"
					"to beat me?", MSGBOX_DEFAULT)
			setflag(B_FLAG_NO_WHITEOUT)
			trainerbattle_no_intro(TRAINER_BENNY, "Well, you sure can!")
			clearflag(B_FLAG_NO_WHITEOUT)
			if (specialvar(VAR_RESULT, GetBattleOutcome) == B_OUTCOME_WON) {
				setflag(FLAG_DEFEATED_BENNY)
				msgbox("Benny: That reminded me of the good\n"
						"old days, when I was the Champion.\l"
						"Thank you, {PLAYER}!\l"
						"This was really inspiring!", MSGBOX_AUTOCLOSE)
			} else {
				msgbox("Benny: Ha!\n"
						"Looks like I still got it in me.\l"
						"Thank you for showing me that Pokémon\l"
						"battling is for all ages!\l"
						"This really refreshed me.", MSGBOX_AUTOCLOSE)
			}
			applymove(LOCALID_REVELATION_LOBBY_BIRCH, moves(walk_up * 2, walk_left * 3))
			setmetatile(5, 4, METATILE_PokemonCenter_Floor_Plain_Alt, FALSE) # Open counter barrier
			special(DrawWholeMapView)
			playse(SE_CLICK)
			applymovement(LOCALID_REVELATION_LOBBY_BIRCH, moves(walk_up * 2, walk_right, face_down))
			delay(25)
			setmetatile(5, 4, METATILE_PokemonCenter_CounterBarrier, TRUE) # Close counter barrier
			special(DrawWholeMapView)
			playse(SE_CLICK)
			waitmovement(0)
			end
		}
		VAR_0x800B, 2 {
			setvar(VAR_0x800B, 0)
			lock
			special(LoadPlayerParty)
			special(HealPlayerParty)
			clearflag(FLAG_FRONTIER_LEVEL)
			msgbox("Thank you for participating in the\n"
					"Battle Tower Challenge!\p"
					"We hope to see you again.", MSGBOX_DEFAULT)
			forcesave
			closemessage
			turnplayer(DIR_SOUTH)
			end
		}
	]
	MAP_SCRIPT_ON_TRANSITION {
		setrespawn(HEAL_LOCATION_REVELATION_LOBBY)
	}
}

script RevelationMap_Lobby_Trigger0 {
	lock
	applymove(LOCALID_REVELATION_LOBBY_BIRCH, moves(face_right))
	msgbox("Benny: Excuse me, {PLAYER}!", MSGBOX_DEFAULT)
	emoteplayer(EMOTE_EXCLAM)
	turnplayer(DIR_SOUTH)
	msgbox("Benny: You have not chosen any Pokémon,\n"
			"yet!\l"
			"How do you plan on challenging the\l"
			"Trainers inside, with your bare fists?\l"
			"Please step back and choose your\l"
			"Pokémon.", MSGBOX_AUTOCLOSE)
	applymoveplayer(moves(walk_down, face_left))
	goto(RevelationMap_Lobby_EventScript_ProfPokemon)
	release
	end
}

script RevelationMap_Lobby_EventScript_ProfPokemon {
	lock
	faceplayer
	if (flag(FLAG_DEFEATED_BENNY) == true) {
		message("Benny: Hey, {PLAYER}!\n"
				"Are you here for battle or a Pokémon?")
		waitmessage
		dynmultichoice(0, 0, FALSE, 3, 0, DYN_MULTICHOICE_CB_NONE, "Pokémon", "Battle", "See ya!")
		switch (var(VAR_RESULT)) {
			case 0:
				setvar(VAR_0x8001, 0)
				setvar(VAR_0x8003, 0)
				goto(EventScript_ChoosePkmnMenu)
			case 1:
				msgbox("Alright, {PLAYER}!\n"
						"No holding back!", MSGBOX_AUTOCLOSE)
				trainerbattle_no_intro(TRAINER_BENNY, "This has been fun!")
			default:
			case 2:
				msgbox("Have a good day!", MSGBOX_AUTOCLOSE)
		}
	} else {
		setvar(VAR_0x8001, 0)
		setvar(VAR_0x8003, 0)
		goto(EventScript_ChoosePkmnMenu)
	}
}

script RevelationMap_Lobby_Trigger1 {
	lock
	applymove(LOCALID_REVELATION_LOBBY_BIRCH, moves(face_right))
	msgbox("Benny: {PLAYER},\n"
			"once you go through that door,\l"
			"you cannot return, for any reasons.\l"
			"Incase you did something wrong,\l"
			"you will have to start over.\p"
			"Benny: So, {PLAYER}, are you absolutely\n"
			"sure that you're ready?", MSGBOX_YESNO)
	if (var(VAR_RESULT) == TRUE) {
		msgbox("Benny: Good luck, {PLAYER}!", MSGBOX_AUTOCLOSE)
		setvar(VAR_REV_STATE, 2)
	} else {
		msgbox("Benny: Alright, take your time.", MSGBOX_AUTOCLOSE)
		applymoveplayer(moves(walk_down))
	}
}

script RevelationMap_Lobby_BattleTower_Teala {
	lock
	msgbox("Would you like to participate in the\n"
			"Battle Tower Challenge?", MSGBOX_YESNO)
	if (var(VAR_RESULT) == YES) {
		message("Which level do you wish to challenge?\n"
				"Level 50 or Open Level?")
		waitmessage
		multichoice(17, 6, MULTI_LEVEL_MODE, FALSE)
		switch (var(VAR_RESULT)) {
			case FRONTIER_LVL_50:
				setflag(FLAG_FRONTIER_LEVEL)
			case FRONTIER_LVL_TENT:
			case MULTI_B_PRESSED:
				special(CloseLink)
				msgbox("We look forward to seeing you on\n"
					"another challenge!")
				release
				end
		}
		frontier_checkineligible
		if (var(VAR_0x8004) == TRUE) {
			msgbox("Hmm. It looks like your party is not\n"
					"eligible for the Battle Tower.\p"
					"Please bring three eligible Pokémon.", MSGBOX_AUTOCLOSE)
		}
		frontier_set(FRONTIER_DATA_LVL_MODE, VAR_RESULT)
		message("Now please select the three eligible\n"
				"Pokémon that are to be entered.")
		special(SavePlayerParty)
		fadescreen(FADE_TO_BLACK)
		callnative(RemoveFollowingPokemon)
		frontier_get(FRONTIER_DATA_LVL_MODE)
		copyvar(VAR_0x8004, VAR_RESULT)
		setvar(VAR_0x8005, FRONTIER_PARTY_SIZE)
		special(ChoosePartyForBattleFrontier)
		waitstate
		if (var(VAR_RESULT) == FALSE) {
			special(LoadPlayerParty)
			callnative(UpdateFollowingPokemon)
			special(CloseLink)
			clearflag(FLAG_FRONTIER_LEVEL)
			msgbox("We look forward to seeing you on\n"
				"another challenge!")
			release
			end
		}
		frontier_set(FRONTIER_DATA_SELECTED_MON_ORDER)
		setvar(VAR_TEMP_CHALLENGE_STATUS, 0)
		tower_init
		tower_set(TOWER_DATA_WIN_STREAK_ACTIVE, TRUE)
		frontier_set(FRONTIER_DATA_PAUSED, FALSE)
		special(LoadPlayerParty)
		closemessage
		delay(2)
		forcesave
		setvar(VAR_TEMP_CHALLENGE_STATUS, 255)
		incrementgamestat(GAME_STAT_ENTERED_BATTLE_TOWER)
		setvar(VAR_BRAVO_TRAINER_BATTLE_TOWER_ON, TRUE)
		special(SavePlayerParty)
		setvar(VAR_0x8004, FRONTIER_UTIL_FUNC_SET_PARTY_ORDER)
		setvar(VAR_0x8005, FRONTIER_PARTY_SIZE)
		special(CallFrontierUtilFunc)
		setvar(VAR_RESULT, 0)
		setvar(VAR_TEMP_1, 0)
		msgbox("Alright, here we go!", MSGBOX_AUTOCLOSE)
		warp(MAP_BATTLE_FRONTIER_BATTLE_TOWER_BATTLE_ROOM, 4, 8)
	}
	release
}

script RevelationMap_Lobby_Purrloin {
	lock
	if (var(VAR_FACING) == DIR_NORTH) {
		applymovement(LOCALID_REVELATION_LOBBY_OGGY, moves(jump_in_place_up_down))
	} else {
		applymovement(LOCALID_REVELATION_LOBBY_OGGY, moves(jump_in_place_left_right))
	}
	moncryscript(SPECIES_PURRLOIN, "Purr!", "Oggy")
	release
	end
}

script RevelationMap_Lobby_BattleChanger {
	lock
	faceplayer
	message("Hello, good sir!\n"
			"What would you like to change in your\l"
			"battles?")
	waitmessage
	dynmultichoice(0, 0, FALSE, 3, 0 DYN_MULTICHOICE_CB_NONE, "Music", "Environment", "See ya!")
	switch (var(VAR_RESULT)) {
		case 0:
			goto(RevelationMap_Lobby_MusicChanger)
		case 1:
			goto(RevelationMap_Lobby_EnvironmentChanger)
		default:
		case 2:
			msgbox("Have a good day!", MSGBOX_AUTOCLOSE)
	}
}

script RevelationMap_Lobby_MusicChanger {
	message("Would you like to change the\n"
			"battle music?")
	dynmultichoice(0, 0, FALSE, 6, 0, DYN_MULTICHOICE_CB_NONE, "VS. Frontier", "VS. Trainer", "VS. Rival", "VS. Gym Leader", "VS. Elite Four", "VS. Champion", "VS. Aqua/Magma", "VS. Wild", "Random!", "Default")
	closemessage
	switch (var(VAR_RESULT)) {
		case 0:
			bufferstring(STR_VAR_1, "VS. Frontier")
			setvar(VAR_BATTLE_MUSIC, MUS_VS_FRONTIER_BRAIN)
			goto(RevelationMap_Lobby_MusicChanged)
		case 1:
			bufferstring(STR_VAR_1, "VS. Trainer")
			setvar(VAR_BATTLE_MUSIC, MUS_VS_TRAINER)
			goto(RevelationMap_Lobby_MusicChanged)
		case 2:
			bufferstring(STR_VAR_1, "VS. Rival")
			setvar(VAR_BATTLE_MUSIC, MUS_VS_RIVAL)
			goto(RevelationMap_Lobby_MusicChanged)
		case 3:
			bufferstring(STR_VAR_1, "VS. Gym Leader")
			setvar(VAR_BATTLE_MUSIC, MUS_VS_GYM_LEADER)
			goto(RevelationMap_Lobby_MusicChanged)
		case 4:
			bufferstring(STR_VAR_1, "VS. Elite Four")
			setvar(VAR_BATTLE_MUSIC, MUS_VS_ELITE_FOUR)
			goto(RevelationMap_Lobby_MusicChanged)
		case 5:
			bufferstring(STR_VAR_1, "VS. Champion")
			setvar(VAR_BATTLE_MUSIC, MUS_VS_CHAMPION)
			goto(RevelationMap_Lobby_MusicChanged)
		case 6:
			bufferstring(STR_VAR_1, "VS. Aqua/Magma")
			setvar(VAR_BATTLE_MUSIC, MUS_VS_AQUA_MAGMA)
			goto(RevelationMap_Lobby_MusicChanged)
		case 7:
			bufferstring(STR_VAR_1, "VS. Wild")
			setvar(VAR_BATTLE_MUSIC, MUS_VS_WILD)
			goto(RevelationMap_Lobby_MusicChanged)
		case 8:
			bufferstring(STR_VAR_1, "a random music")
			setvar(VAR_BATTLE_MUSIC, 1)
			goto(RevelationMap_Lobby_MusicChanged)
		default:
		case 9:
			bufferstring(STR_VAR_1, "the default Trainer music")
			setvar(VAR_BATTLE_MUSIC, 0)
			goto(RevelationMap_Lobby_MusicChanged)
	}
	release
	end
}

script RevelationMap_Lobby_MusicChanged {
	playse(SE_SAVE)
	waitse
	msgbox("The battle music has been changed to\n"
			"{STR_VAR_1}.\l"
			"Enjoy the tunes!", MSGBOX_AUTOCLOSE)
	release
	end
}

script RevelationMap_Lobby_EnvironmentChanger {
	message("Would you like to change the\n"
			"battle environment?")
	dynmultichoice(0, 0, FALSE, 6, 0, DYN_MULTICHOICE_CB_NONE, "Grass", "Long Grass", "Sand", "Water", "Underwater", "Pond", "Mountain", "Cave", "Building", "Plain", "Snow", "Ice", "Random!", "Default")
	closemessage
	switch (var(VAR_RESULT)) {
		case 0:
			bufferstring(STR_VAR_1, "the grass")
			setvar(VAR_BATTLE_ENVIRONMENT, BATTLE_ENVIRONMENT_GRASS + 100) // because _GRASS is 0
			goto(RevelationMap_Lobby_EnvironmentChanged)
		case 1:
			bufferstring(STR_VAR_1, "the long grass")
			setvar(VAR_BATTLE_ENVIRONMENT, BATTLE_ENVIRONMENT_LONG_GRASS)
			goto(RevelationMap_Lobby_EnvironmentChanged)
		case 2:
			bufferstring(STR_VAR_1, "the sand")
			setvar(VAR_BATTLE_ENVIRONMENT, BATTLE_ENVIRONMENT_SAND)
			goto(RevelationMap_Lobby_EnvironmentChanged)
		case 3:
			bufferstring(STR_VAR_1, "the water")
			setvar(VAR_BATTLE_ENVIRONMENT, BATTLE_ENVIRONMENT_WATER)
			goto(RevelationMap_Lobby_EnvironmentChanged)
		case 4:
			bufferstring(STR_VAR_1, "the underwater")
			setvar(VAR_BATTLE_ENVIRONMENT, BATTLE_ENVIRONMENT_UNDERWATER)
			goto(RevelationMap_Lobby_EnvironmentChanged)
		case 5:
			bufferstring(STR_VAR_1, "the pond")
			setvar(VAR_BATTLE_ENVIRONMENT, BATTLE_ENVIRONMENT_POND)
			goto(RevelationMap_Lobby_EnvironmentChanged)
		case 6:
			bufferstring(STR_VAR_1, "the mountain")
			setvar(VAR_BATTLE_ENVIRONMENT, BATTLE_ENVIRONMENT_MOUNTAIN)
			goto(RevelationMap_Lobby_EnvironmentChanged)
		case 7:
			bufferstring(STR_VAR_1, "the cave")
			setvar(VAR_BATTLE_ENVIRONMENT, BATTLE_ENVIRONMENT_CAVE)
			goto(RevelationMap_Lobby_EnvironmentChanged)
		case 8:
			bufferstring(STR_VAR_1, "the building")
			setvar(VAR_BATTLE_ENVIRONMENT, BATTLE_ENVIRONMENT_BUILDING)
			goto(RevelationMap_Lobby_EnvironmentChanged)
		case 9:
			bufferstring(STR_VAR_1, "the plain")
			setvar(VAR_BATTLE_ENVIRONMENT, BATTLE_ENVIRONMENT_PLAIN)
			goto(RevelationMap_Lobby_EnvironmentChanged)
		case 10:
			bufferstring(STR_VAR_1, "the snow")
			setvar(VAR_BATTLE_ENVIRONMENT, BATTLE_ENVIRONMENT_SNOW)
			goto(RevelationMap_Lobby_EnvironmentChanged)
		case 11:
			bufferstring(STR_VAR_1, "the ice")
			setvar(VAR_BATTLE_ENVIRONMENT, BATTLE_ENVIRONMENT_ICE)
			goto(RevelationMap_Lobby_EnvironmentChanged)
		case 12:
			bufferstring(STR_VAR_1, "a random")
			setvar(VAR_BATTLE_ENVIRONMENT, 12)
			goto(RevelationMap_Lobby_EnvironmentChanged)
		default:
		case 13:
			bufferstring(STR_VAR_1, "the default")
			setvar(VAR_BATTLE_ENVIRONMENT, 0)
			goto(RevelationMap_Lobby_EnvironmentChanged)
	}
	release
	end
}

script RevelationMap_Lobby_EnvironmentChanged {
	playse(SE_SAVE)
	waitse
	msgbox("The battle environment has been changed\n"
			"to {STR_VAR_1} environment.\l"
			"Enjoy the terrain!", MSGBOX_AUTOCLOSE)
	release
	end
}

text Text_PleaseComeAgain {
	"Please come again if you change your\n"
	"mind."
}

script RevelationMap_Lobby_EventScript_EventMoveRelearner {
	lock
	faceplayer
	special(ShowBattlePointsWindow)
	if (specialvar(VAR_TEMP_1, GetFrontierBattlePoints) >= 15) {
		msgbox("Hi, I'm the event moves relearner.\n"
				"For just 15 Battle Points, I can\l"
				"teach your Pokémon some exclusive\l"
				"moves!\p"
				"Would you like to learn some\n"
				"exclusive moves?", MSGBOX_YESNO)
	} else {
		msgbox("Hi, I'm the event moves relearner.\p"
				"…\n"
				"It looks like you don't have enough\l"
				"Battle Points to learn exclusive\l"
				"moves.\p"
				"Come back again when you have at\n"
				"least 15 Battle Points.", MSGBOX_DEFAULT)
				special(CloseBattlePointsWindow)
		release
		end
	}
	closemessage
	if (var(VAR_RESULT) == YES) {
		setflag(FLAG_EVENT_MOVE_RELEARNER)
		goto(EventScript_ChooseMonForTeaching)
	} else {
		msgbox(Text_PleaseComeAgain, MSGBOX_DEFAULT)
		special(CloseBattlePointsWindow)
		release
		end
	}
}

script EventScript_ChooseMonForTeaching {
	msgbox("Which Pokémon needs teaching?", MSGBOX_DEFAULT)
	special(ChooseMonForMoveRelearner)
	waitstate
	if (var(VAR_0x8004) == PARTY_NOTHING_CHOSEN) {
		clearflag(FLAG_EVENT_MOVE_RELEARNER)
		msgbox(Text_PleaseComeAgain, MSGBOX_DEFAULT)
		release
		end
	}
	special(ShowBattlePointsWindow)
	special(IsSelectedMonEgg)
	if (var(VAR_RESULT) == TRUE) {
		msgbox("Hunh? There isn't a single move that\n"
				"I can teach an Egg.", MSGBOX_DEFAULT)
		goto(EventScript_ChooseMonForTeaching)
	}
	if (var(VAR_0x8005) == NO) {
		msgbox("Sorry…\p"
				"It doesn't appear as if I have any move\n"
				"I can teach that Pokémon.", MSGBOX_DEFAULT)
		goto(EventScript_ChooseMonForTeaching)
	} else {
		special(ShowBattlePointsWindow)
		goto(EventScript_ChooseMoveToTeach)
	}
}

script EventScript_ChooseMoveToTeach {
	msgbox("Which move should I teach?", MSGBOX_DEFAULT)
	special(TeachMoveRelearnerMove)
	waitstate
	if (var(VAR_0x8004) == 0) {
		special(ShowBattlePointsWindow)
		goto(EventScript_ChooseMonForTeaching)
	}
	setvar(VAR_0x8004, 15)
	special(TakeFrontierBattlePoints)
	special(ShowBattlePointsWindow)
	clearflag(FLAG_EVENT_MOVE_RELEARNER)
	msgbox("Thank you!\n"
			"Please come again!", MSGBOX_DEFAULT)
	special(CloseBattlePointsWindow)
	release
	end
}
