mapscripts RevelationMap_Gym5_MapScripts {}

script RevelationMap_Gym5_LeaderPrajith { // Fire-type Gym
	lock
	faceplayer
	if (var(VAR_GYM_DEFEATED_COUNTER) == 8) {
		msgbox("{SPEAKER NAME_PRAJITH}"
				"Go to the Challengers' Arena!", MSGBOX_NPC)
	} elif (flag(FLAG_DEFEATED_PRAJITH) == true) {
		msgbox("{SPEAKER NAME_PRAJITH}"
				"You've already felt my heat.\p"
				"I won't burn you again.", MSGBOX_NPC)
	} else {
		msgbox("{SPEAKER NAME_PRAJITH}"
				"The flames roar here!\p"
				"Only trainers with courage can\n"
				"withstand the heat.\p"
				"Step forward if you dare,\n"
				"let's see if you can handle fire!", MSGBOX_DEFAULT)
		trainerbattle_no_intro(TRAINER_PRAJITH, "Ahh!\nYou've doused my flames!")
		playfanfare(MUS_OBTAIN_BADGE)
		message("{PLAYER} beat Prajith!")
		waitfanfare
		waitmessage
		msgbox("{SPEAKER NAME_PRAJITH}"
				"The fire bends to your will.\p"
				"That determination is hotter than any\n"
				"blaze.\p"
				"Take this Badge,\n"
				"proof that you can endure any inferno!", MSGBOX_AUTOCLOSE)
		setflag(FLAG_DEFEATED_PRAJITH)
		setvar(VAR_DEFEATED_PRAJITH, 1)
		addvar(VAR_GYM_DEFEATED_COUNTER, 1)
		completesubquest(QUEST_5_BEAT_GYM_PRAJITH, SUB_QUEST_14_BEAT_PRAJITH)
		clearflag(FLAG_HIDE_GILSTON)
	}
	release
	end
}

script RevelationMap_Gym5_KindlerDelson { // Fire-type Trainer
	trainerbattle_single(TRAINER_DELSON, "My flames will scorch everything in\ntheir path!\pCan you handle the heat?", "Sparks… extinguished?!", RevelationMap_Gym5_KindlerDelsonSubQuest)
	msgbox("{SPEAKER NAME_DELSON}"
			"Wow… you really put out my fire.\p"
			"Leader Prajith's flames will be even\n"
			"tougher!", MSGBOX_AUTOCLOSE)
	end
}

script RevelationMap_Gym5_KindlerDelsonSubQuest {
	completesubquest(QUEST_5_BEAT_GYM_PRAJITH, SUB_QUEST_13_BEAT_DELSON)
}
