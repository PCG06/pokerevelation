mapscripts RevelationMap_Gym7_MapScripts {}

script RevelationMap_Gym7_LeaderSnehal { // Flying-type Gym
	lock
	faceplayer
	if (var(VAR_GYM_DEFEATED_COUNTER) == 8) {
		msgbox("{SPEAKER NAME_SNEHAL}"
				"Go to the Challengers' Arena!", MSGBOX_NPC)
	} elif (flag(FLAG_DEFEATED_SNEHAL) == true) {
		msgbox("{SPEAKER NAME_SNEHAL}"
				"Once you've flown this high…\p"
				"there's nothing more I can show you.", MSGBOX_NPC)
	} else {
		msgbox("{SPEAKER NAME_SNEHAL}"
				"The sky is boundless,\n"
				"just like our potential.\p"
				"But not everyone can ride the winds.\p"
				"Tell me,\n"
				"can you soar as high as I can?", MSGBOX_DEFAULT)
		trainerbattle_no_intro(TRAINER_SNEHAL, "You've clipped my wings…!")
		playfanfare(MUS_OBTAIN_BADGE)
		message("{PLAYER} beat Snehal!")
		waitfanfare
		waitmessage
		msgbox("{SPEAKER NAME_SNEHAL}"
				"You rode the winds with grace and\n"
				"strength.\p"
				"Few can rise this high without falling.\p"
				"Take this Badge,\n"
				"it proves you can fly among the best.", MSGBOX_AUTOCLOSE)
		setflag(FLAG_DEFEATED_SNEHAL)
		setvar(VAR_DEFEATED_SNEHAL, 1)
		addvar(VAR_GYM_DEFEATED_COUNTER, 1)
		completesubquest(QUEST_7_BEAT_GYM_SNEHAL, SUB_QUEST_20_BEAT_SNEHAL)
		clearflag(FLAG_HIDE_ADITHYA)
	}
	release
	end
}

script RevelationMap_Gym7_BirdKeeperHandam { // Flying-type Trainer
	trainerbattle_single(TRAINER_HANDAM, "My Flying-types will take you down\nfrom above!", "Grounded…? I can't believe it!", RevelationMap_Gym7_BirdKeeperHandamSubQuest)
	msgbox("{SPEAKER NAME_HANDAM}"
			"You've got talent.\p"
			"But battling Snehal is like facing a\n"
			"storm in the sky.", MSGBOX_AUTOCLOSE)
	end
}

script RevelationMap_Gym7_BirdKeeperHandamSubQuest {
	completesubquest(QUEST_7_BEAT_GYM_SNEHAL, SUB_QUEST_19_BEAT_HANDAM)
}
