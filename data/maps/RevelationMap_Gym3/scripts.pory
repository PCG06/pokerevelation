mapscripts RevelationMap_Gym3_MapScripts  {
	MAP_SCRIPT_ON_TRANSITION {
		startquest(QUEST_3_BEAT_GYM_PREM, FALSE)
	}
}

script RevelationMap_Gym3_LeaderPrem { // Ghost-type Gym
	lock
	faceplayer
	if (var(VAR_GYM_DEFEATED_COUNTER) == 8) {
		msgbox("{SPEAKER NAME_PREM}"
				"Go to the Challengers' Arena!", MSGBOX_NPC)
	} elif (flag(FLAG_DEFEATED_PREM) == true) {
		msgbox("{SPEAKER NAME_PREM}"
				"The spirits whisper of your victory…\p"
				"There's nothing more I can test.", MSGBOX_NPC)
	} else {
		msgbox("{SPEAKER NAME_PREM}"
				"Do you feel it?\n"
				"The chill in the air…\p"
				"This Gym is where the living meet the\n"
				"spirits.\p"
				"Don't be afraid, unless you should be.", MSGBOX_DEFAULT)
		trainerbattle_no_intro(TRAINER_PREM, "Heh…\nYou've faced your fears and won…")
		playfanfare(MUS_OBTAIN_BADGE)
		message("{PLAYER} beat Prem!")
		waitfanfare
		waitmessage
		msgbox("{SPEAKER NAME_PREM}"
				"You were not shaken by the unknown.\p"
				"That resolve is what truly frightens\n"
				"the spirits.\p"
				"Take this Badge,\n"
				"and let it guide you through the\l"
				"shadows.", MSGBOX_AUTOCLOSE)
		setflag(FLAG_DEFEATED_PREM)
		setflag(FLAG_BADGE03_GET)
		setvar(VAR_DEFEATED_PREM, 1)
		addvar(VAR_GYM_DEFEATED_COUNTER, 1)
		completesubquest(QUEST_3_BEAT_GYM_PREM, SUB_QUEST_3_BEAT_PREM)
		clearflag(FLAG_HIDE_RASHEL)
	}
	release
	end
}

script RevelationMap_Gym3_PsychicDon { // Ghost-type Trainer
	trainerbattle_single(TRAINER_DON, "The spirits speak to me…\pThey say your journey ends here!", "The voices…\nThey were wrong?", RevelationMap_Gym3_PsychicDonSubQuest)
	msgbox("{SPEAKER NAME_DON}"
			"The spirits are restless.\p"
			"Perhaps they wanted you to win all\n"
			"along.", MSGBOX_AUTOCLOSE)
	end
}

script RevelationMap_Gym3_PsychicDonSubQuest {
	completesubquest(QUEST_3_BEAT_GYM_PREM, SUB_QUEST_3_BEAT_DON)
}
