mapscripts RevelationMap_Gym8_MapScripts  {
	MAP_SCRIPT_ON_TRANSITION {
		startquest(QUEST_8_BEAT_GYM_RAJESH, FALSE)
	}
}

script RevelationMap_Gym8_LeaderRajesh { // Dragon-type Gym
	lock
	faceplayer
	if (var(VAR_GYM_DEFEATED_COUNTER) == 8) {
		msgbox("{SPEAKER NAME_RAJESH}"
				"Go to the Challengers' Arena!", MSGBOX_NPC)
	} elif (flag(FLAG_DEFEATED_RAJESH) == true) {
		msgbox("{SPEAKER NAME_RAJESH}"
				"You've already conquered my dragons.\p"
				"There's nothing more I can test.", MSGBOX_NPC)
	} else {
		msgbox("{SPEAKER NAME_RAJESH}"
				"Dragons are the peak of Pokémon\n"
				"strength, majestic, ancient, and\l"
				"feared by all.\p"
				"If you want this badge,\n"
				"prove that your courage burns hotter\l"
				"than a dragon's fire!", MSGBOX_DEFAULT)
		trainerbattle_no_intro(TRAINER_RAJESH, "Impossible…\nMy dragons, brought to their knees…!")
		playfanfare(MUS_OBTAIN_BADGE)
		message("{PLAYER} beat Rajesh!")
		waitfanfare
		waitmessage
		msgbox("{SPEAKER NAME_RAJESH}"
				"You've tamed the storm of dragons\n"
				"itself.\p"
				"That spirit is worthy of respect…\n"
				"and of this badge.\p"
				"Carry it proudly,\n"
				"the path ahead will test you like\l"
				"never before!", MSGBOX_AUTOCLOSE)
		setflag(FLAG_DEFEATED_RAJESH)
		setflag(FLAG_BADGE08_GET)
		setvar(VAR_DEFEATED_RAJESH, 1)
		addvar(VAR_GYM_DEFEATED_COUNTER, 1)
		completesubquest(QUEST_8_BEAT_GYM_RAJESH, SUB_QUEST_8_BEAT_RAJESH)
		clearflag(FLAG_HIDE_RION)
	}
	release
	end
}

script RevelationMap_Gym8_BirdKeeperDeon { // Dragon-type Trainer
	trainerbattle_single(TRAINER_DEON, "Dragons are fierce, but I've\ntrained under Rajesh.\pYou'll need more than luck to break\nthrough!", "So this is the strength of a future\nChampion…\limpressive.", RevelationMap_Gym8_BirdKeeperDeonSubQuest)
	msgbox("{SPEAKER NAME_DEON}"
			"If you could beat me,\n"
			"maybe you really do stand a chance\l"
			"against Rajesh.", MSGBOX_AUTOCLOSE)
	end
}

script RevelationMap_Gym8_BirdKeeperDeonSubQuest {
	completesubquest(QUEST_8_BEAT_GYM_RAJESH, SUB_QUEST_8_BEAT_DEON)
}
