script RevelationMap_ChallengersArena_FightMelwin {
	playse(SE_SLIDING_DOOR)
	addobject(LOCALID_REVELATION_CHALLENGER_6)
	applymove(LOCALID_REVELATION_CHALLENGER_6, RevelationMap_ChallengersArena_Movement_WalkFromEntranceToStadium)
	msgbox("{SPEAKER NAME_MELWIN}"
			"You made it this far…\n"
			"But the real challenge starts now!\l"
			"I won't go easy - not when the\l"
			"championship is on the line!", MSGBOX_DEFAULT)
	trainerbattle_no_intro(TRAINER_MELWIN, "I gave it all I had…") // Annoying Gen9 hyperoffence team
	msgbox("{SPEAKER NAME_MELWIN}"
			"You earned your spot.\n"
			"I threw everything I had at you,\l"
			"but you just wouldn't go down!\p"
			"Now go claim your title.", MSGBOX_DEFAULT)
	playse(SE_APPLAUSE)
	msgbox("{SPEAKER NAME_ANNOUNCER}"
			"{PLAYER} has beaten all\n"
			"six challengers!\p"
			"That means… {PLAYER} wins the\n"
			"Revelation Tournament!\l"
			"What an incredible performance!", MSGBOX_AUTOCLOSE)
	applymove(LOCALID_REVELATION_CHALLENGER_6, RevelationMap_ChallengersArena_Movement_WalkFromStadiumToExit)
	playse(SE_SLIDING_DOOR)
	removeobject(LOCALID_REVELATION_CHALLENGER_6)
	delay(60)
	addvar(VAR_CHALLENGERS_BEAT, 1)
	call(RevelationMap_ChallengersArena_IntroduceChampionYashas)
	release
	end
}

script RevelationMap_ChallengersArena_IntroduceChampionYashas {
	lock
	playse(SE_APPLAUSE)
	msgbox("{SPEAKER NAME_ANNOUNCER}"
			"BUT…\p"
			"A final opponent remains…\n"
			"The very first Champion of the\l"
			"Revelation Tournament!\p"
			"Undefeated! Unmatched!\n"
			"The Legendary Yashas!", MSGBOX_AUTOCLOSE)
	waitse
	goto(RevelationMap_ChallengersArena_ChoiceMenu3)
	release
	end
}

script RevelationMap_ChallengersArena_FightChampionYashas {
	fadenewbgm(MUS_VS_FRONTIER_BRAIN)
	delay(6)
	playse(SE_SLIDING_DOOR)
	addobject(LOCALID_REVELATION_CHAMPION)
	applymove(LOCALID_REVELATION_CHAMPION, RevelationMap_ChallengersArena_Movement_WalkFromEntranceToStadium)
	msgbox("{SPEAKER NAME_YASHAS}"
			"I've watched your battles.\n"
			"You've got skill, that's for sure.\l"
			"But skill alone won't beat me.\p"
			"Let's see if you've got what\n"
			"it takes to be the best.", MSGBOX_DEFAULT)
	trainerbattle_no_intro(TRAINER_YASHAS, "Looks like I'm not No. 1 anymore…")
	msgbox("{SPEAKER NAME_YASHAS}"
			"You're the real deal.\n"
			"I haven't been pushed like that\l"
			"in years.\p"
			"The title of Champion is yours now.\n"
			"Don't disappoint me.", MSGBOX_DEFAULT)
	playse(SE_APPLAUSE)
	call(RevelationMap_HallOfFame_Teleport)
	end
}

script RevelationMap_HallOfFame_Teleport {
	warp(MAP_REVELATION_MAP_HALL_OF_FAME, 7, 16)
}

movement RevelationMap_ChallengersArena_Movement_WalkFromEntranceToStadium {
	walk_up * 2,
	walk_right * 4,
	walk_up * 3,
	walk_left * 3
}

movement RevelationMap_ChallengersArena_Movement_WalkFromStadiumToExit {
	walk_right * 3,
	walk_down * 3,
	walk_left * 4,
	walk_down * 2
}