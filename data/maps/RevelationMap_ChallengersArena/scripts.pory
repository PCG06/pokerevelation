mapscripts RevelationMap_ChallengersArena_MapScripts {
	MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
		VAR_REV_STATE, 3 {
			turnplayer(DIR_NORTH)
		}
	]
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_REV_STATE, 3 {
			setvar(VAR_REV_STATE, 4)
			call(RevelationMap_ChallengersArena_PlayerEnters)
		}
	]
}

script RevelationMap_ChallengersArena_PlayerEnters {
	delay(8)
	lock
	playse(SE_APPLAUSE)
	msgbox("{SPEAKER NAME_ANNOUNCER}"
			"Welcome to the Revelation\n"
			"Tournament!", MSGBOX_AUTOCLOSE)
	delay(16)
	applymoveplayer(moves(walk_up * 2, walk_left * 4, walk_up * 3, walk_right * 3))
	msgbox("{SPEAKER NAME_ANNOUNCER}"
			"On the left, entering the\n"
			"arena to take on the Strong 6…\p"
			"It's {PLAYER} from Littleroot Town,\n"
			"Hoenn! Good luck!", MSGBOX_AUTOCLOSE)
	delay(16)
	// Trainer fights
	call(RevelationMap_ChallengersArena_ChoiceMenu1)
}

script RevelationMap_ChallengersArena_TriggerChoiceMenu {
	lock
	if (var(VAR_CHALLENGERS_BEAT) == 0) {
		call(RevelationMap_ChallengersArena_ChoiceMenu1)
	} elif (var(VAR_CHALLENGERS_BEAT) < 6) {
		call(RevelationMap_ChallengersArena_ChoiceMenu2)
	} else {
		call(RevelationMap_ChallengersArena_ChoiceMenu3)
	}
	release
	end
}

script EventScript_MovePlayerToPos {
	getplayerxy(VAR_0x800A, VAR_0x800B)
	if (var(VAR_0x800A) == 8 && var(VAR_0x800B) == 5) {
		applymoveplayer(moves(walk_down, face_right))
	} elif (var(VAR_0x800A) == 8 && var(VAR_0x800B) == 7) {
		applymoveplayer(moves(walk_up, face_right))
	} elif (var(VAR_0x800A) == 9 && var(VAR_0x800B) == 6) {
		applymoveplayer(moves(walk_left, face_right))
	} elif (var(VAR_0x800A) == 7 && var(VAR_0x800B) == 6) {
		applymoveplayer(moves(walk_right))
	} else { # Just in case
		applymoveplayer(moves(face_right))
	}
}

script RevelationMap_ChallengersArena_ChoiceMenu1 {
	message("{SPEAKER NAME_ANNOUNCER}"
			"So, {PLAYER}!\n"
			"Are you ready for the Revelation\l"
			"Tournament?")
	waitmessage
	dynmultichoice(20, 8, FALSE, 2, 1, DYN_MULTICHOICE_CB_NONE, "Battle", "Rest")
	closemessage
	switch (var(VAR_RESULT)) {
		case 0:
			msgbox("{SPEAKER NAME_ANNOUNCER}"
					"Okay, get ready!", MSGBOX_AUTOCLOSE)
			call(EventScript_MovePlayerToPos)
			goto(RevelationMap_ChallengersArena_FightManvitha)

		default:
		case 1:
			msgbox("{SPEAKER NAME_ANNOUNCER}"
					"Okay, take your time.", MSGBOX_AUTOCLOSE)
			call(EventScript_MovePlayerToPos)
			release
			end
	}
}

script RevelationMap_ChallengersArena_ChoiceMenu2 {
	message("{SPEAKER NAME_ANNOUNCER}"
			"So, {PLAYER}!\n"
			"Are you ready for the next round?")
	waitmessage
	dynmultichoice(20, 8, FALSE, 2, 1, DYN_MULTICHOICE_CB_NONE, "Continue", "Rest")
	closemessage
	switch (var(VAR_RESULT)) {
		case 0:
			msgbox("{SPEAKER NAME_ANNOUNCER}"
					"Okay, get ready!", MSGBOX_AUTOCLOSE)
			call(EventScript_MovePlayerToPos)
			switch (var(VAR_CHALLENGERS_BEAT)) {
				case 1:
					goto(RevelationMap_ChallengersArena_FightKevin)
				case 2:
					goto(RevelationMap_ChallengersArena_FightLohith)
				case 3:
					goto(RevelationMap_ChallengersArena_FightAnmol)
				case 4:
					goto(RevelationMap_ChallengersArena_FightArshad)
				case 5:
					goto(RevelationMap_ChallengersArena_FightMelwin)
			}

		default:
		case 1:
			msgbox("Okay, take your time.", MSGBOX_AUTOCLOSE)
			call(EventScript_MovePlayerToPos)
			release
			end
	}
}

script RevelationMap_ChallengersArena_ChoiceMenu3 {
	message("{SPEAKER NAME_ANNOUNCER}"
			"So, {PLAYER}!\n"
			"Are you ready for the final battle?")
	waitmessage
	dynmultichoice(20, 8, FALSE, 2, 1, DYN_MULTICHOICE_CB_NONE, "Battle", "Rest")
	closemessage
	switch (var(VAR_RESULT)) {
		case 0:
			msgbox("{SPEAKER NAME_ANNOUNCER}"
					"Okay, get ready!", MSGBOX_AUTOCLOSE)
			call(EventScript_MovePlayerToPos)
			call(RevelationMap_ChallengersArena_FightChampionYashas)

		default:
		case 1:
			msgbox("{SPEAKER NAME_ANNOUNCER}"
					"Okay, take your time.", MSGBOX_AUTOCLOSE)
			call(EventScript_MovePlayerToPos)
			release
			end
	}
}

script RevelationMap_ChallengersArena_FightManvitha {
	addobject(LOCALID_REVELATION_CHALLENGER_1)
	applymove(LOCALID_REVELATION_CHALLENGER_1, RevelationMap_ChallengersArena_Movement_WalkFromEntranceToStadium)
	msgbox("{SPEAKER NAME_MANVITHA}"
			"The sun always shines on\n"
			"the battlefield when I'm around.\l"
			"Let's see if you can handle the heat!", MSGBOX_DEFAULT)
	trainerbattle_no_intro(TRAINER_MANVITHA, "I wasn't expecting that…") // Sun team
	msgbox("{SPEAKER NAME_MANVITHA}"
			"Not bad at all.\n"
			"You've got real potential.\l"
			"Keep that fire burning!", MSGBOX_DEFAULT)
	playse(SE_APPLAUSE)
	msgbox("{SPEAKER NAME_ANNOUNCER}"
			"{PLAYER} claims Round 1!\n"
			"The crowd is loving this!\l"
			"Next up, Round 2!", MSGBOX_AUTOCLOSE)
	applymove(LOCALID_REVELATION_CHALLENGER_1, RevelationMap_ChallengersArena_Movement_WalkFromStadiumToExit)
	playse(SE_SLIDING_DOOR)
	removeobject(LOCALID_REVELATION_CHALLENGER_1)
	delay(60)
	addvar(VAR_CHALLENGERS_BEAT, 1)
	release
	end
}

