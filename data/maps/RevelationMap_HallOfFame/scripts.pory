const LOCALID_CHAMPION = 1

mapscripts RevelationMap_HallOfFame_MapScripts {
	MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
		VAR_REV_STATE, 4 {
			turnplayer(DIR_NORTH)
		}
	]
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_REV_STATE, 4 {
			setvar(VAR_REV_STATE, 5)
			call(RevelationMap_HallOfFame_EventScript_EnterHallOfFame)
		}
    ]
}

script RevelationMap_HallOfFame_EventScript_EnterHallOfFame {
	lockall
	applymovement(LOCALID_CHAMPION, moves(walk_up * 6))
	applymoveplayer(moves(walk_up * 6))
	applymovement(LOCALID_CHAMPION, Common_Movement_WalkInPlaceFasterRight)
	applymoveplayer(Common_Movement_WalkInPlaceFasterLeft)
	msgbox("Yashas: This room…\p"
	        "This is where we keep records of\n"
	        "Pokémon that prevailed through\l"
	        "harsh battles.\p"
	        "It is here that the League Champions\n"
	        "are honored.", MSGBOX_DEFAULT)
	closemessage
	applymovement(LOCALID_CHAMPION, moves(walk_up * 5))
	applymoveplayer(moves(walk_up * 5))
	delay(20)
	applymovement(LOCALID_CHAMPION, Common_Movement_WalkInPlaceFasterRight)
	applymoveplayer(Common_Movement_WalkInPlaceFasterLeft)
	msgbox("Yashas: Come on, let's record your\n"
            "name as a Trainer who triumphed over\l"
            "the Pokémon League, and the names of\l"
            "the partners who battled with you.", MSGBOX_DEFAULT)
	closemessage
	applymovement(LOCALID_CHAMPION, Common_Movement_WalkInPlaceFasterUp)
	applymoveplayer(Common_Movement_WalkInPlaceFasterUp)
	delay(20)
	dofieldeffect(FLDEFF_HALL_OF_FAME_RECORD)
	waitfieldeffect(FLDEFF_HALL_OF_FAME_RECORD)
	delay(40)
	setvar(VAR_TEMP_1, 1)
	setflag(FLAG_IS_CHAMPION)
	call(RevelationMap_HallOfFame_EventScript_SetFlagsAndVars)
	setrespawn(HEAL_LOCATION_REVELATION_LOBBY)
	fadescreenspeed(FADE_TO_BLACK, 24)
	special(GameClear)
	waitstate
	releaseall
	end
}

script RevelationMap_HallOfFame_EventScript_SetFlagsAndVars {
    setvar(VAR_GYM_DEFEATED_COUNTER, 0)
	setvar(VAR_REV_STATE, 2)

	clearflag(FLAG_DEFEATED_JAKE)
	setvar(VAR_DEFEATED_JAKE, 0)
	cleartrainerflag(TRAINER_PRAJESH)
	cleartrainerflag(TRAINER_PAWAN)

	clearflag(FLAG_DEFEATED_REEVE)
	setvar(VAR_DEFEATED_REEVE, 0)
	cleartrainerflag(TRAINER_PREMAL)
	cleartrainerflag(TRAINER_HANSTON)

	clearflag(FLAG_DEFEATED_PREM)
	setvar(VAR_DEFEATED_PREM, 0)
	cleartrainerflag(TRAINER_DON)
	cleartrainerflag(TRAINER_RASHEL)

	clearflag(FLAG_DEFEATED_JAISON)
	setvar(VAR_DEFEATED_JAISON, 0)
	cleartrainerflag(TRAINER_DARA)
	cleartrainerflag(TRAINER_AKSHARA)

	clearflag(FLAG_DEFEATED_PRAJITH)
	setvar(VAR_DEFEATED_PRAJITH, 0)
	cleartrainerflag(TRAINER_DELSON)
	cleartrainerflag(TRAINER_GILSTON)

	clearflag(FLAG_DEFEATED_VARUN)
	setvar(VAR_DEFEATED_VARUN, 0)
	cleartrainerflag(TRAINER_DARWIN)
	cleartrainerflag(TRAINER_MONVISH)

	clearflag(FLAG_DEFEATED_SNEHAL)
	setvar(VAR_DEFEATED_SNEHAL, 0)
	cleartrainerflag(TRAINER_ADITHYA)
	cleartrainerflag(TRAINER_HANDAM)

	clearflag(FLAG_DEFEATED_RAJESH)
	setvar(VAR_DEFEATED_RAJESH, 0)
	cleartrainerflag(TRAINER_DEON)
	cleartrainerflag(TRAINER_RION)

	givemonset(SPECIES_MEWTWO_APOCALYPSE, OT_ID_REEVE)
	givemonset(SPECIES_ZOJZION, OT_ID_VARUN)
	givemonset(SPECIES_MANTISTRIKE, OT_ID_JAKE)
	givemonset(SPECIES_PYROLIN, OT_ID_PRAJITH)
	givemonset(SPECIES_STRATOSPIRA, OT_ID_SNEHAL)
	givemonset(SPECIES_PHANTOMAR, OT_ID_PREM)
	givemonset(SPECIES_LEVIADON, OT_ID_RAJESH)
	givemonset(SPECIES_AMANISTE, OT_ID_JAISON)
	return
}
