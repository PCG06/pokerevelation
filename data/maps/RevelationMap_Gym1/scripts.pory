mapscripts RevelationMap_Gym1_MapScripts {}

script RevelationMap_Gym1_LeaderJake { // Rock-type Gym
    lock
    faceplayer
    if (var(VAR_GYM_DEFEATED_COUNTER) == 8) {
        msgbox("Jake: Go to Challengers' Arena text", MSGBOX_NPC)
    } elif (flag(FLAG_DEFEATED_JAKE) == true) {
        msgbox("Jake: Defeated text!", MSGBOX_NPC)
    } else {
        msgbox("Jake: Before battle text!", MSGBOX_DEFAULT)
        trainerbattle_no_intro(TRAINER_JAKE, "Defeat text…")
        playfanfare(MUS_OBTAIN_BADGE)
        message("{PLAYER} beat Jake!")
        waitfanfare
        waitmessage
        msgbox("Jake: After battle text.", MSGBOX_AUTOCLOSE)
        setflag(FLAG_DEFEATED_JAKE)
        setvar(VAR_DEFEATED_JAKE, 1)
        addvar(VAR_GYM_DEFEATED_COUNTER, 1)
    }
    release
    end
}

script RevelationMap_Gym1_CamperPrajesh { // Grass-type Trainer
	trainerbattle_single(TRAINER_PRAJESH, "Prajesh: Before battle text!", "Defeat text…")
	msgbox("Prajesh: After battle text.", MSGBOX_AUTOCLOSE)
	end
}
