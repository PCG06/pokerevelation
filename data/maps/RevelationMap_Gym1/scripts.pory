mapscripts RevelationMap_Gym1_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		startquest(QUEST_1_BEAT_GYM_JAKE, FALSE)
	}
}

script RevelationMap_Gym1_LeaderJake { // Rock-type Gym
	lock
	faceplayer
	if (var(VAR_GYM_DEFEATED_COUNTER) == 8) {
		msgbox("{SPEAKER NAME_JAKE}"
				"Go to the Challengers' Arena!", MSGBOX_NPC)
	} elif (flag(FLAG_DEFEATED_JAKE) == true) {
		msgbox("{SPEAKER NAME_JAKE}"
			"Enjoying the victory? Good!\p"
			"But remember,\n"
			"the road only gets steeper from here.", MSGBOX_NPC)
	} else {
		msgbox("{SPEAKER NAME_JAKE}"
				"So you've made it here already?\p"
				"Not bad for a rookie!\n"
				"But strength isn't just about speed.\p"
				"Like a Rock, you need to stand firm!\p"
				"Show me if you've got what it takes!", MSGBOX_AUTOCLOSE)
		trainerbattle_no_intro(TRAINER_JAKE, "Whoa!\nYou're tougher than I thought!")
		playfanfare(MUS_OBTAIN_BADGE)
		message("{PLAYER} beat Jake!")
		waitfanfare
		waitmessage
		msgbox("{SPEAKER NAME_JAKE}"
				"You really shook me up!\n"
				"I guess even solid Rock can crack\l"
				"against the right strike.\p"
				"Here, take this Badge.\n"
				"It'll mark the start of your climb!", MSGBOX_AUTOCLOSE)
		setflag(FLAG_DEFEATED_JAKE)
		setflag(FLAG_BADGE01_GET)
		setvar(VAR_DEFEATED_JAKE, 1)
		addvar(VAR_GYM_DEFEATED_COUNTER, 1)
		completesubquest(QUEST_1_BEAT_GYM_JAKE, SUB_QUEST_1_BEAT_JAKE)
		clearflag(FLAG_HIDE_PAWAN)
	}
	release
	end
}

script RevelationMap_Gym1_CamperPrajesh { // Grass-type Trainer
	trainerbattle_single(TRAINER_PRAJESH, "Don't think this Gym is just rocks!\nI'll show you how tough even Grass\lcan be!", "Guess I got… cut down.", RevelationMap_Gym1_CamperPrajeshSubQuest)
	msgbox("{SPEAKER NAME_PRAJESH}"
		"Whew… I thought I had the advantage.\p"
		"Jake is way sturdier than me though!", MSGBOX_AUTOCLOSE)
	end
}

script RevelationMap_Gym1_CamperPrajeshSubQuest {
	completesubquest(QUEST_1_BEAT_GYM_JAKE, SUB_QUEST_1_BEAT_PRAJESH)
}
