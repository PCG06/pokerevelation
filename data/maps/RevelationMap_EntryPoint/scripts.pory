mapscripts RevelationMap_EntryPoint_MapScripts {
	MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
		VAR_REV_STATE, 2 {
			turnplayer(DIR_NORTH)
			setvar(VAR_REV_STATE, 3)
		}
	]
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_DEFEATED_JAKE, 1 {
			call(RevelationMap_EntryPoint_TriggerBugCatcherPawan)
		}
		VAR_DEFEATED_REEVE, 1 {
			call(RevelationMap_EntryPoint_TriggerSuperNerdHanston)
		}
		VAR_DEFEATED_PREM, 1 {
			call(RevelationMap_EntryPoint_TriggerHexManiacRashel)
		}
		VAR_DEFEATED_JAISON, 1 {
			call(RevelationMap_EntryPoint_TriggerLadyAkshara)
		}
		VAR_DEFEATED_PRAJITH, 1 {
			call(RevelationMap_EntryPoint_TriggerBlackBeltGilston)
		}
		VAR_DEFEATED_VARUN, 1 {
			call(RevelationMap_EntryPoint_TriggerGuiratistMonvish)
		}
		VAR_DEFEATED_SNEHAL, 1 {
			call(RevelationMap_EntryPoint_TriggerFishermanAdithya)
		}
		VAR_DEFEATED_RAJESH, 1 {
			call(RevelationMap_EntryPoint_TriggerExpertRion)
		}
	]
	MAP_SCRIPT_ON_LOAD {
		if (var(VAR_GYM_DEFEATED_COUNTER) == 8) { // Opens the main door when all gym leaders are defeated
			setmetatile(23, 1, METATILE_EliteFour_OpenDoor_Frame, FALSE)
			setmetatile(23, 2, METATILE_EliteFour_OpenDoorChampion_Opening, FALSE)
			special(DrawWholeMapView)
		}
	}
}

script RevelationMap_EntryPoint_TriggerBugCatcherPawan { // Bug-type Trainer
	emote(LOCALID_REVELATION_BUG_CATCHER, EMOTE_EXCLAM)
	applymove(LOCALID_REVELATION_BUG_CATCHER, MoveLeftToPlayer)
	turnplayer(DIR_EAST)
	trainerbattle_single(TRAINER_PAWAN, "Before battle text!", "Defeat text…", RevelationMap_EntryPoint_BugCatcherPawan)
	msgbox("{SPEAKER NAME_PAWAN}"
            "After battle text.", MSGBOX_AUTOCLOSE)
	end
}

script RevelationMap_EntryPoint_BugCatcherPawan {
	if (var(VAR_DEFEATED_JAKE) == 1) {
		applymove(LOCALID_REVELATION_BUG_CATCHER, MoveRightToStand)
		setvar(VAR_DEFEATED_JAKE, 2)
	} elif (var(VAR_DEFEATED_JAKE) == 2) {
		lock
		faceplayer
		msgbox("{SPEAKER NAME_PAWAN}"
            	"After battle text.", MSGBOX_NPC)
	} else {
		lock
		faceplayer
		msgbox("{SPEAKER NAME_PAWAN}"
            	"Random text.", MSGBOX_NPC)
	}
	release
	end
}

