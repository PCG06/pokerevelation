mapscripts RevelationMap_Gym6_MapScripts  {
	MAP_SCRIPT_ON_TRANSITION {
		startquest(QUEST_6_BEAT_GYM_VARUN, FALSE)
	}
}

script RevelationMap_Gym6_LeaderVarun { // Electric-type Gym
	lock
	faceplayer
	if (var(VAR_GYM_DEFEATED_COUNTER) == 8) {
		msgbox("{SPEAKER NAME_VARUN}"
				"Go to the Challengers' Arena!", MSGBOX_NPC)
	} elif (flag(FLAG_DEFEATED_VARUN) == true) {
		msgbox("{SPEAKER NAME_VARUN}"
				"You've already felt my voltage once.\p"
				"I won't shock you again.", MSGBOX_NPC)
	} else {
		msgbox("{SPEAKER NAME_VARUN}"
				"This Gym crackles with power!\p"
				"Electricity is fast, fierce, and\n"
				"unstoppable.\p"
				"Let's see if you can handle the\n"
				"current!", MSGBOX_DEFAULT)
		trainerbattle_no_intro(TRAINER_VARUN, "What?!\nYou overloaded my system!")
		playfanfare(MUS_OBTAIN_BADGE)
		message("{PLAYER} beat Varun!")
		waitfanfare
		waitmessage
		msgbox("{SPEAKER NAME_VARUN}"
				"You're charged with real power.\p"
				"Your strength lit up the battlefield\n"
				"brighter than any spark.\p"
				"Take this Badge,\n"
				"proof that you can withstand any\l"
				"current!", MSGBOX_AUTOCLOSE)
		setflag(FLAG_DEFEATED_VARUN)
		setflag(FLAG_BADGE06_GET)
		setvar(VAR_DEFEATED_VARUN, 1)
		addvar(VAR_GYM_DEFEATED_COUNTER, 1)
		completesubquest(QUEST_6_BEAT_GYM_VARUN, SUB_QUEST_6_BEAT_VARUN)
		clearflag(FLAG_HIDE_MONVISH)
	}
	release
	end
}

script RevelationMap_Gym6_ScientistDarwin { // Poison-type Trainer
	trainerbattle_single(TRAINER_DARWIN, "Toxins are nature's chemistry!\pI'll show you the science of decay!", "My formula… it went bad…", RevelationMap_Gym6_ScientistDarwinSubQuest)
	msgbox("{SPEAKER NAME_DARWIN}"
			"Poison is unpredictable…\p"
			"Just like the human body's reaction\n"
			"to it.", MSGBOX_AUTOCLOSE)
	end
}


script RevelationMap_Gym6_ScientistDarwinSubQuest {
	completesubquest(QUEST_6_BEAT_GYM_VARUN, SUB_QUEST_6_BEAT_DARWIN)
}
