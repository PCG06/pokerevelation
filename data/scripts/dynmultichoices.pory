script Common_EventScript_TrainerBattleMenu {
	lock
	faceplayer
	message("Select a category of Trainers.")
	waitmessage
	dynmultichoice(0, 0, FALSE, 4, 0, DYN_MULTICHOICE_CB_NONE, "Gym Leaders", "Challenge Trainers", "Postgame Trainers", "Nevermind")
	closemessage
	switch (var(VAR_RESULT)) {
		case 0:
			goto(EventScript_GymLeaderChoices)
		case 1:
			goto(EventScript_ChallengeTrainerChoices)
		case 2:
			goto(EventScript_PostgameTrainerChoices)
		default:
		case 3:
			msgbox("Come back when you're ready!", MSGBOX_DEFAULT)
			release
			end
	}
	release
	end
}

text Text_UghILost {
	"Ugh, I lost!"
}

text Text_WhichTrainerToChallenge {
	"Which Trainer do you want to\n"
	"challenge?"
}

text Text_AllTrainersDefeated {
	"You have already defeated all\n"
	"Trainers here!\p"
	"Would you like to battle again?"
}

text Text_YouHaveAlreadyDefeatedTrainer {
	"You have already defeated this\n"
	"Trainer!\p"
	"Would you like to battle again?"
}

text Text_YouHaveAlreadyDefeatedChallenger {
	"You have already defeated this\n"
	"Challenger!\p"
	"Would you like to battle again?"
}

text Text_YouHaveAlreadyDefeatedPostgameTrainer {
	"You have already defeated this\n"
	"Postgame Trainer!\p"
	"Would you like to battle again?"
}

script EventScript_GymLeaderChoices {
	message("Select a Gym.")
	waitmessage
	dynmultichoice(0, 0, FALSE, 6, 0, DYN_MULTICHOICE_CB_NONE,
		"Jake's Gym 1", "Reeve's Gym 2", "Prem's Gym 3", "Jaison's Gym 4", "Prajith's Gym 5", "Varun's Gym 6", "Snehal's Gym 7", "Rajesh's Gym 8", "Back")
	closemessage
	switch (var(VAR_RESULT)) {
		case 0:
			goto(EventScript_Gym1Trainers)
		case 1:
			goto(EventScript_Gym2Trainers)
		case 2:
			goto(EventScript_Gym3Trainers)
		case 3:
			goto(EventScript_Gym4Trainers)
		case 4:
			goto(EventScript_Gym5Trainers)
		case 5:
			goto(EventScript_Gym6Trainers)
		case 6:
			goto(EventScript_Gym7Trainers)
		case 7:
			goto(EventScript_Gym8Trainers)
		default:
		case 8:
			goto(Common_EventScript_TrainerBattleMenu)
	}
	release
	end
}

script EventScript_ChallengeGym1 {
	message(Text_WhichTrainerToChallenge)
	waitmessage
	dynmultichoice(0, 0, FALSE, 4, 0, DYN_MULTICHOICE_CB_NONE,
	"Bug Catcher Pawan", "Camper Prajesh", "Leader Jake", "Back")
	closemessage
	switch (var(VAR_RESULT)) {
		case 0:
			if (defeated(TRAINER_PAWAN)) {
				msgbox(Text_YouHaveAlreadyDefeatedTrainer, MSGBOX_YESNO)
				if (var(VAR_RESULT) == TRUE) {
					trainerbattle_no_intro(TRAINER_PAWAN, Text_UghILost)
				}
			} else {
				trainerbattle_no_intro(TRAINER_PAWAN, Text_UghILost)
			}
			goto(EventScript_Gym1Trainers)
		case 1:
			if (defeated(TRAINER_PRAJESH)) {
				msgbox(Text_YouHaveAlreadyDefeatedTrainer, MSGBOX_YESNO)
				if (var(VAR_RESULT) == TRUE) {
					trainerbattle_no_intro(TRAINER_PRAJESH, Text_UghILost)
				}
			} else {
				trainerbattle_no_intro(TRAINER_PRAJESH, Text_UghILost)
			}
			goto(EventScript_Gym1Trainers)
		case 2:
			if (defeated(TRAINER_JAKE)) {
				msgbox(Text_YouHaveAlreadyDefeatedTrainer, MSGBOX_YESNO)
				if (var(VAR_RESULT) == TRUE) {
					trainerbattle_no_intro(TRAINER_JAKE, Text_UghILost)
				}
			} else {
				trainerbattle_no_intro(TRAINER_JAKE, Text_UghILost)
			}
			goto(EventScript_Gym1Trainers)
		default:
		case 3:
			goto(EventScript_GymLeaderChoices)
			end
	}
}

script EventScript_Gym1Trainers {
	if (defeated(TRAINER_PAWAN) && defeated(TRAINER_PRAJESH) && defeated(TRAINER_JAKE)) {
		msgbox(Text_AllTrainersDefeated, MSGBOX_YESNO)
		if (var(VAR_RESULT) == TRUE) {
			call(EventScript_ChallengeGym1)
		} else {
			goto(EventScript_GymLeaderChoices)
		}
	} else {
		call(EventScript_ChallengeGym1)
		goto(EventScript_GymLeaderChoices)
	}
}

