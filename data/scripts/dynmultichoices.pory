script EventScript_ChallengeTrainers {
	message("Which Challenger do you want to\nchallenge?")
	waitmessage
	dynmultichoice(0, 0, FALSE, 6, 0, DYN_MULTICHOICE_CB_NONE,
		"1. Challenger Manvitha", "2. Challenger Kevin", "3. Challenger Lohith",
		"4. Challenger Anmol", "5. Challenger Arshad", "6. Challenger Melwin",
		"7. Champion Bardar", "Back")
	closemessage
	switch (var(VAR_RESULT)) {
		case 0:
			if (defeated(TRAINER_MANVITHA)) {
				msgbox(Text_YouHaveAlreadyDefeatedChallenger, MSGBOX_YESNO)
				if (var(VAR_RESULT) == TRUE) {
					trainerbattle_no_intro(TRAINER_MANVITHA, Text_UghILost)
					goto(EventScript_ChallengeTrainerChoices)
				}
			}
			else {
				trainerbattle_no_intro(TRAINER_MANVITHA, Text_UghILost)
				goto(EventScript_ChallengeTrainerChoices)
			}
		case 1:
