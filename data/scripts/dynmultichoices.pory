				trainerbattle_no_intro(TRAINER_ARSHAD, Text_UghILost)
				goto(EventScript_ChallengeTrainerChoices)
			}
		case 5:
			if (defeated(TRAINER_MELWIN)) {
				msgbox(Text_YouHaveAlreadyDefeatedChallenger, MSGBOX_YESNO)
				if (var(VAR_RESULT) == TRUE) {
					trainerbattle_no_intro(TRAINER_MELWIN, Text_UghILost)
					goto(EventScript_ChallengeTrainerChoices)
				}
			}
			else {
				trainerbattle_no_intro(TRAINER_MELWIN, Text_UghILost)
				goto(EventScript_ChallengeTrainerChoices)
			}
		case 6:
			if (defeated(TRAINER_YASHAS)) {
				msgbox("You have already defeated the\n"
						"Champion!\p"
						"Would you like to battle again?", MSGBOX_YESNO)
				if (var(VAR_RESULT) == TRUE) {
					trainerbattle_no_intro(TRAINER_YASHAS, Text_UghILost)
					goto(EventScript_ChallengeTrainerChoices)
				}
			}
			else {
				trainerbattle_no_intro(TRAINER_YASHAS, Text_UghILost)
				goto(EventScript_ChallengeTrainerChoices)
			}
		default:
		case 7:
			goto(Common_EventScript_TrainerBattleMenu)
	}
}

script EventScript_ChallengeTrainerChoices {
	if (defeated(TRAINER_MANVITHA) && defeated(TRAINER_KEVIN) && defeated(TRAINER_LOHITH) 
		&& defeated(TRAINER_ANMOL) && defeated(TRAINER_ARSHAD) && defeated(TRAINER_MELWIN) 
		&& defeated(TRAINER_YASHAS)) {
		msgbox("You have already defeated all\n"
				"Challengers here!\p"
				"Would you like to battle again?", MSGBOX_YESNO)
		if (var(VAR_RESULT) == TRUE) {
			call(EventScript_ChallengeTrainers)
		}
		else {
			goto(Common_EventScript_TrainerBattleMenu)
		}
	}
	else {
		call(EventScript_ChallengeTrainers)
	}
}

script EventScript_ChallengePostgameTrainers {
	message(Text_WhichTrainerToChallenge)
	waitmessage
	dynmultichoice(0, 0, FALSE, 3, 0, DYN_MULTICHOICE_CB_NONE,
		"1. Professor Benny", "2. Master Aaron", "Back")
	closemessage
	switch (var(VAR_RESULT)) {
		case 0:
			if (defeated(TRAINER_BENNY)) {
				msgbox(Text_YouHaveAlreadyDefeatedPostgameTrainer, MSGBOX_YESNO)
				if (var(VAR_RESULT) == TRUE) {
					trainerbattle_no_intro(TRAINER_BENNY, Text_UghILost)
					goto(EventScript_PostgameTrainerChoices)
				}
			}
			else {
				trainerbattle_no_intro(TRAINER_BENNY, Text_UghILost)
				goto(EventScript_PostgameTrainerChoices)
			}
		case 1:
			if (defeated(TRAINER_AARON)) {
				msgbox(Text_YouHaveAlreadyDefeatedPostgameTrainer, MSGBOX_YESNO)
				if (var(VAR_RESULT) == TRUE) {
					trainerbattle_no_intro(TRAINER_AARON, Text_UghILost)
					goto(EventScript_PostgameTrainerChoices)
				}
			}
			else {
				trainerbattle_no_intro(TRAINER_AARON, Text_UghILost)
				goto(EventScript_PostgameTrainerChoices)
			}
		default:
		case 2:
			goto(Common_EventScript_TrainerBattleMenu)
	}
}

script EventScript_PostgameTrainerChoices {
	if (defeated(TRAINER_BENNY) && defeated(TRAINER_AARON)) {
		msgbox("You have already defeated all\n"
				"Postgame Trainers here!\p"
				"Would you like to battle again?", MSGBOX_YESNO)
		if (var(VAR_RESULT) == TRUE) {
			call(EventScript_ChallengePostgameTrainers)
		}
		else {
			goto(Common_EventScript_TrainerBattleMenu)
		}
	}
	else {
		call(EventScript_ChallengePostgameTrainers)
	}
}

# Pokémon menu
script Common_EventScript_ChoosePkmnMenu {
	lock
	faceplayer
	if (var(VAR_GOT_PARTY_PKMN) < 2) {
		setvar(VAR_GOT_PARTY_PKMN, 1)
	}
	goto(Common_EventScript_ChoosePkmnMulti)
	release
	end
}

script Common_EventScript_ChoosePkmnMulti {
	if (var(VAR_GOT_PARTY_PKMN) == 6) {
		setflag(FLAG_GOT_PARTY_PKMN)
	}
	if (flag(FLAG_GOT_PARTY_PKMN) == true) {		
		msgbox("You have chosen your Pokémon!\n"
				"Start your adventure!", MSGBOX_NPC)
	} else {
		message("Select a group of Pokémon.")
		waitmessage
		dynmultichoice(0, 0, TRUE, 6, 0, DYN_MULTICHOICE_CB_NONE, "Group 1 (A-E)", "Group 2 (F-K)", "Group 3 (K-N)", "Group 4 (O-S)", "Group 5 (S-Z)", "Nevermind")
		closemessage
		switch (var(VAR_RESULT)) {
			case 0:
				goto(EventScript_Group1Choices)
			case 1:
				goto(EventScript_Group2Choices)
			case 2:
				goto(EventScript_Group3Choices)
			case 3:
				goto(EventScript_Group4Choices)
			case 4:
				goto(EventScript_Group5Choices)
			default:
			case 5:
				buffernumberstring(STR_VAR_2, VAR_GOT_PARTY_PKMN)
				msgbox("Start adventure with only {STR_VAR_2} Pokémon?", MSGBOX_YESNO)
				if (var(VAR_RESULT) == TRUE) {
					setflag(FLAG_GOT_PARTY_PKMN)
					msgbox("Start your adventure!", MSGBOX_DEFAULT)
					release
					end
				} else {
					goto(Common_EventScript_ChoosePkmnMulti)
				}
		}
	}
	release
	end
}

text Text_SelectPkmn {
	"Please select your Pokémon."
}

text Text_DoYouWantPkmn {
	"Do you want {STR_VAR_1}?"
}

script EventScript_Givemonset {
	playfanfare(MUS_OBTAIN_ITEM)
	givemonset(VAR_TEMP_TRANSFERRED_SPECIES)
	addvar(VAR_GOT_PARTY_PKMN, 1)
	buffernumberstring(STR_VAR_2, VAR_GOT_PARTY_PKMN)
	message("{PKMN} No {STR_VAR_2}.\n"
			"{PLAYER} received {STR_VAR_1}!")
	showmonpic(VAR_TEMP_TRANSFERRED_SPECIES, FALSE, 10, 3)
	waitmessage
	waitfanfare
	msgbox (gText_NicknameThisPokemon, MSGBOX_YESNO)
	hidemonpic
	if (var(VAR_RESULT) == FALSE) {
		goto(Common_EventScript_ChoosePkmnMulti)
	}
	call(Common_EventScript_GetGiftMonPartySlot)
	call(Common_EventScript_NameReceivedPartyMon)
	goto(Common_EventScript_ChoosePkmnMulti)
	end
}

