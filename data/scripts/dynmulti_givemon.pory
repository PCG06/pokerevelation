script EventScript_ChoosePkmnMenu {
	if (var(VAR_GOT_PARTY_PKMN) == 6 && !flag(FLAG_DEFEATED_BENNY)) {
		msgbox("{SPEAKER NAME_BENNY}"
				"You have chosen your Pokémon!\n"
				"Start your adventure!", MSGBOX_NPC)
	} else {
		message("{SPEAKER NAME_BENNY}"
				"Select a group of Pokémon.")
		copyvar(VAR_TEMP_A, VAR_TEMP_B)
		waitmessage
		dynmultichoice(0, 0, FALSE, 5, VAR_TEMP_A, DYN_MULTICHOICE_CB_NONE, "Starters", "Group 1 (A-F)", "Group 2 (F-K)", "Group 3 (K-O)", "Group 4 (P-S)", "Group 5 (S-Z)", "Back")
		closemessage
		copyvar(VAR_TEMP_B, VAR_RESULT)
		switch (var(VAR_RESULT)) {
			case 0:
				goto(EventScript_ChooseStarterMenu)
			case 1:
				goto(EventScript_Group1Choices)
			case 2:
				goto(EventScript_Group2Choices)
			case 3:
				goto(EventScript_Group3Choices)
			case 4:
				goto(EventScript_Group4Choices)
			case 5:
				goto(EventScript_Group5Choices)
			default:
			case 6:
				setvar(VAR_TEMP_B, 0)
				msgbox("{SPEAKER NAME_BENNY}"
						"Talk to me when you're ready.", MSGBOX_NPC)
		}
	}
	release
	end
}

text Text_SelectPkmn {
	"{SPEAKER NAME_BENNY}"
	"Please select your Pokémon."
}

script EventScript_YouWantThisPkmn {
	bufferspeciesname(STR_VAR_1, VAR_TEMP_TRANSFERRED_SPECIES)
	showmonpic(VAR_TEMP_TRANSFERRED_SPECIES, FALSE, 10, 3)
	msgbox("{SPEAKER NAME_BENNY}"
			"Do you want {STR_VAR_1}?", MSGBOX_YESNO)
	if (var(VAR_RESULT) == TRUE) {
		goto(EventScript_Givemonset)
	} else {
		hidemonpic
		return
	}
}

script EventScript_Givemonset {
	playfanfare(MUS_OBTAIN_ITEM)
	givemonset(VAR_TEMP_TRANSFERRED_SPECIES)
	addvar(VAR_GOT_PARTY_PKMN, 1)
	setvar(VAR_TEMP_B, 0)
	setvar(VAR_TEMP_D, 0)
	closemessage
	if (!flag(FLAG_SYS_POKEMON_GET)) {
		setflag(FLAG_SYS_POKEMON_GET)
	}
	if (!flag(FLAG_DEFEATED_BENNY)) {
		setvar(VAR_REV_STATE, 1)
		buffernumberstring(STR_VAR_1, VAR_GOT_PARTY_PKMN)
		message("Pokémon No: {STR_VAR_1}.\n"
				"{PLAYER} received {STR_VAR_2}!")
	} else {
		message("{PLAYER} received {STR_VAR_2}!")
	}
	waitmessage
	waitfanfare
	call(Common_EventScript_NicknameGiftPokemon)
	closemessage
	hidemonpic
	if (!flag(FLAG_DEFEATED_BENNY)) {
		goto(EventScript_ChoosePkmnMenu)
	}
	end
}

script EventScript_ChooseStarterMenu {
	message("{SPEAKER NAME_BENNY}"
			"Please select your starter.")
	copyvar(VAR_TEMP_C, VAR_TEMP_D)
	waitmessage
	dynmultichoice(0, 0, FALSE, 5, VAR_TEMP_C, DYN_MULTICHOICE_CB_NONE,
		"Venusaur", "Charizard", "Blastoise", "Pikachu",
		"Meganium", "Typhlosion", "Typhlosion-H", "Feraligatr",
		"Sceptile", "Blaziken", "Swampert",
		"Torterra", "Infernape", "Empoleon",
		"Serperior", "Emboar", "Samurott", "Samurott-H",
		"Chesnaught", "Delphox", "Greninja",
		"Decidueye", "Decidueye-H", "Incineroar", "Primarina",
		"Rillaboom", "Cinderace", "Inteleon",
		"Meowscarada", "Skeledirge", "Quaquaval", "Back"
	)
	closemessage
	copyvar(VAR_TEMP_D, VAR_RESULT)
	switch (var(VAR_RESULT)) {
		case 0:
			setvar(VAR_TEMP_TRANSFERRED_SPECIES, SPECIES_VENUSAUR)
			call(EventScript_YouWantThisPkmn)
			goto(EventScript_ChooseStarterMenu)
